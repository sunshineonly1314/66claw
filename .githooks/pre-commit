#!/usr/bin/env bash
#
# Git Pre-Commit Hook - Security Checks
# Prevents committing sensitive data and security vulnerabilities
#
# Installation:
#   git config core.hooksPath .githooks
#

set -e

echo "Running security checks..."

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}[SECURITY ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    print_success "No files to check"
    exit 0
fi

# Track if any security issues were found
SECURITY_ISSUES=0

# =============================================================================
# Check 1: Hardcoded Credentials
# =============================================================================
echo "Checking for hardcoded credentials..."

# Patterns to detect
CREDENTIAL_PATTERNS=(
    'clawdbotCN778'           # Compromised token
    'password\s*=\s*["\047][^"\047]{3,}'  # password = "..."
    'api[_-]?key\s*=\s*["\047][^"\047]{10,}'  # api_key = "..."
    'secret\s*=\s*["\047][^"\047]{10,}'   # secret = "..."
    'token\s*=\s*["\047][^"\047]{10,}'    # token = "..."
    'AKIA[0-9A-Z]{16}'        # AWS Access Key
    'AIza[0-9A-Za-z_-]{35}'   # Google API Key
    'sk-[a-zA-Z0-9]{32,}'     # OpenAI API Key
    'ghp_[a-zA-Z0-9]{36}'     # GitHub Personal Access Token
)

for pattern in "${CREDENTIAL_PATTERNS[@]}"; do
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            if grep -qiE "$pattern" "$file"; then
                print_error "Potential credential found in $file"
                grep --color=always -nE "$pattern" "$file" | head -5
                SECURITY_ISSUES=$((SECURITY_ISSUES + 1))
            fi
        fi
    done
done

# =============================================================================
# Check 2: Hardcoded IP Addresses
# =============================================================================
echo "Checking for hardcoded IP addresses..."

# Block known sensitive IPs
BLOCKED_IPS=(
    '121\.43\.61\.90'         # Old proxy IP
    '127\.0\.0\.1'            # Localhost (should use variable)
    '169\.254\.169\.254'      # AWS metadata
    '0\.0\.0\.0'              # Unspecified address
)

for ip in "${BLOCKED_IPS[@]}"; do
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && [[ ! "$file" =~ \.(md|txt)$ ]]; then
            if grep -qE "$ip" "$file"; then
                print_error "Hardcoded IP address $ip found in $file"
                grep --color=always -nE "$ip" "$file"
                SECURITY_ISSUES=$((SECURITY_ISSUES + 1))
            fi
        fi
    done
done

# =============================================================================
# Check 3: HTTP URLs (should be HTTPS)
# =============================================================================
echo "Checking for insecure HTTP URLs..."

for file in $STAGED_FILES; do
    if [ -f "$file" ] && [[ "$file" =~ \.(ts|js|json)$ ]]; then
        # Allow HTTP for localhost/127.0.0.1
        if grep -qE 'http://[^l][^o][^c]' "$file"; then
            print_warning "HTTP URL found in $file (should use HTTPS)"
            grep --color=always -nE 'http://[^l]' "$file" | head -3
        fi
    fi
done

# =============================================================================
# Check 4: Large Files
# =============================================================================
echo "Checking for large files..."

MAX_FILE_SIZE=$((5 * 1024 * 1024))  # 5MB

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        file_size=$(wc -c < "$file")
        if [ "$file_size" -gt "$MAX_FILE_SIZE" ]; then
            print_warning "Large file detected: $file ($(numfmt --to=iec-i --suffix=B $file_size))"
            print_warning "Consider using Git LFS for large files"
        fi
    fi
done

# =============================================================================
# Check 5: Sensitive File Extensions
# =============================================================================
echo "Checking for sensitive files..."

SENSITIVE_EXTENSIONS=(
    '\.env$'
    '\.pem$'
    '\.key$'
    '\.p12$'
    '\.pfx$'
    '\.jks$'
    '\.keystore$'
)

for ext in "${SENSITIVE_EXTENSIONS[@]}"; do
    for file in $STAGED_FILES; do
        if [[ "$file" =~ $ext ]] && [[ ! "$file" =~ \.example$ ]]; then
            print_error "Sensitive file detected: $file"
            print_error "Do NOT commit credential files!"
            SECURITY_ISSUES=$((SECURITY_ISSUES + 1))
        fi
    done
done

# =============================================================================
# Check 6: Debug/Console.log statements in production code
# =============================================================================
echo "Checking for debug statements..."

for file in $STAGED_FILES; do
    if [ -f "$file" ] && [[ "$file" =~ \.(ts|js)$ ]] && [[ ! "$file" =~ \.test\. ]] && [[ ! "$file" =~ /tests/ ]]; then
        if grep -qE 'console\.(log|debug|trace)\(' "$file"; then
            print_warning "console.log found in $file (use logger instead)"
        fi
    fi
done

# =============================================================================
# Summary
# =============================================================================
echo ""
echo "========================================"

if [ "$SECURITY_ISSUES" -gt 0 ]; then
    print_error "Found $SECURITY_ISSUES security issue(s)!"
    echo ""
    echo "Commit blocked. Please fix the issues above and try again."
    echo ""
    echo "If you're absolutely sure this is a false positive, you can:"
    echo "  1. Fix the issue (recommended)"
    echo "  2. Use: git commit --no-verify (NOT recommended)"
    exit 1
else
    print_success "All security checks passed!"
    echo "========================================"
    exit 0
fi
