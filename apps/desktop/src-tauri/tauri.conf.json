{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawdbotCN",
  "version": "2026.2.16",
  "identifier": "com.clawdbot.cn.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../../dist/control-ui"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClawdbotCN AI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://fonts.font.im; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://fonts.font.im data:; img-src 'self' data: blob: https:; connect-src 'self' ws://localhost:18789 ws://127.0.0.1:18789 http://localhost:18789 http://127.0.0.1:18789 https://api.openclawcn.com https://*.anthropic.com; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
