# OpenClawCN gateway — Podman Quadlet (rootless)
# Installed by setup-podman.sh into openclawcn's ~/.config/containers/systemd/
# {{OPENCLAWCN_HOME}} is replaced at install time.

[Unit]
Description=OpenClawCN gateway (rootless Podman)

[Container]
Image=openclawcn:local
ContainerName=openclawcn
UserNS=keep-id
Volume={{OPENCLAWCN_HOME}}/.openclawcn:/home/node/.openclawcn
EnvironmentFile={{OPENCLAWCN_HOME}}/.openclawcn/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
