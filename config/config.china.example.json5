/**
 * OpenClawCN 中国本地化配置示例
 * China Localization Configuration Example
 *
 * 配置文件位置: ~/.openclawcn/config.json5
 * 使用方法:
 *   1. 复制此文件到 ~/.openclawcn/config.json5
 *   2. 填入你的 API Key 和配置
 *   3. 启动网关: openclawcn gateway run
 *
 * 环境变量 (可选):
 *   - DASHSCOPE_API_KEY: 通义千问 API Key
 *   - DOUBAO_API_KEY: 豆包 API Key
 *   - DEEPSEEK_API_KEY: DeepSeek API Key
 *   - ZHIPU_API_KEY: 智谱 GLM API Key
 */
{
  // ============================================================================
  // 网关配置 (Gateway Configuration)
  // ============================================================================
  gateway: {
    // 绑定地址: "loopback" (仅本机) | "lan" (局域网) | "all" (所有)
    // 建议: 保持 loopback，通过 Tailscale 或 SSH 隧道远程访问
    bind: "loopback",

    // 端口号
    port: 18789,

    // 认证配置 (非 loopback 时必须设置)
    // auth: {
    //   token: "your-secure-token-here",
    //   // 或者使用密码
    //   // password: "your-password-here",
    // },

    // Control UI 配置
    controlUi: {
      // 允许不安全认证 (仅开发环境使用)
      // allowInsecureAuth: false,
    },
  },

  // ============================================================================
  // 大模型配置 (LLM Models Configuration)
  // ============================================================================
  models: {
    // 模式: "merge" (合并到内置模型) | "replace" (替换)
    mode: "merge",

    providers: {
      // ----------------------------------------------------------------------
      // 通义千问 Qwen (阿里云 DashScope)
      // API 申请: https://dashscope.console.aliyun.com/
      // ----------------------------------------------------------------------
      "qwen-dashscope": {
        baseUrl: "https://dashscope.aliyuncs.com/compatible-mode/v1",
        // API Key: 填入你的 DashScope API Key，或使用环境变量 DASHSCOPE_API_KEY
        apiKey: "YOUR_DASHSCOPE_API_KEY",
        api: "openai-completions",
        models: [
          {
            id: "qwen-max",
            name: "通义千问 Max",
            reasoning: false,
            input: ["text"],
            contextWindow: 32000,
            maxTokens: 8192,
          },
          {
            id: "qwen-plus",
            name: "通义千问 Plus",
            reasoning: false,
            input: ["text"],
            contextWindow: 131072,
            maxTokens: 8192,
          },
          {
            id: "qwen-turbo",
            name: "通义千问 Turbo",
            reasoning: false,
            input: ["text"],
            contextWindow: 131072,
            maxTokens: 8192,
          },
          {
            id: "qwen-vl-max",
            name: "通义千问 VL Max (视觉)",
            reasoning: false,
            input: ["text", "image"],
            contextWindow: 32000,
            maxTokens: 2000,
          },
          {
            id: "qwen-coder-plus",
            name: "通义千问 Coder Plus",
            reasoning: false,
            input: ["text"],
            contextWindow: 131072,
            maxTokens: 8192,
          },
        ],
      },

      // ----------------------------------------------------------------------
      // 豆包 Doubao (字节跳动火山引擎)
      // API 申请: https://console.volcengine.com/ark
      // 注意: 需要先在控制台创建推理接入点，模型 ID 需要替换为你的接入点 ID
      // ----------------------------------------------------------------------
      doubao: {
        baseUrl: "https://ark.cn-beijing.volces.com/api/v3",
        // API Key: 填入你的火山引擎 API Key
        apiKey: "YOUR_DOUBAO_API_KEY",
        api: "openai-completions",
        models: [
          {
            // 重要: 将此 ID 替换为你在火山引擎控制台创建的推理接入点 ID
            // 格式类似: ep-20240xxx-xxxxx
            id: "YOUR_ENDPOINT_ID",
            name: "豆包 Pro",
            reasoning: false,
            input: ["text"],
            contextWindow: 32000,
            maxTokens: 4096,
          },
        ],
      },

      // ----------------------------------------------------------------------
      // DeepSeek
      // API 申请: https://platform.deepseek.com/
      // ----------------------------------------------------------------------
      deepseek: {
        baseUrl: "https://api.deepseek.com",
        // API Key: 填入你的 DeepSeek API Key
        apiKey: "YOUR_DEEPSEEK_API_KEY",
        api: "openai-completions",
        models: [
          {
            id: "deepseek-chat",
            name: "DeepSeek Chat",
            reasoning: false,
            input: ["text"],
            contextWindow: 64000,
            maxTokens: 8192,
          },
          {
            id: "deepseek-coder",
            name: "DeepSeek Coder",
            reasoning: false,
            input: ["text"],
            contextWindow: 64000,
            maxTokens: 8192,
          },
          {
            id: "deepseek-reasoner",
            name: "DeepSeek R1 (推理)",
            reasoning: true,
            input: ["text"],
            contextWindow: 64000,
            maxTokens: 8192,
          },
        ],
      },

      // ----------------------------------------------------------------------
      // 智谱 GLM (智谱AI)
      // API 申请: https://open.bigmodel.cn/
      // ----------------------------------------------------------------------
      glm: {
        baseUrl: "https://open.bigmodel.cn/api/paas/v4",
        // API Key: 填入你的智谱 API Key
        apiKey: "YOUR_ZHIPU_API_KEY",
        api: "openai-completions",
        models: [
          {
            id: "glm-4-plus",
            name: "GLM-4 Plus",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 4096,
          },
          {
            id: "glm-4",
            name: "GLM-4",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 4096,
          },
          {
            id: "glm-4-flash",
            name: "GLM-4 Flash",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 4096,
          },
          {
            id: "glm-4v-plus",
            name: "GLM-4V Plus (视觉)",
            reasoning: false,
            input: ["text", "image"],
            contextWindow: 8000,
            maxTokens: 1000,
          },
          {
            id: "codegeex-4",
            name: "CodeGeeX-4 (代码)",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 4096,
          },
        ],
      },
    },
  },

  // ============================================================================
  // 渠道配置 (Channels Configuration)
  // ============================================================================
  channels: {
    // 默认设置
    defaults: {
      // 群聊策略: "open" | "allowlist"
      groupPolicy: "allowlist",
    },

    // ----------------------------------------------------------------------
    // 飞书配置 (Feishu/Lark)
    // 应用创建: https://open.feishu.cn/app
    // ----------------------------------------------------------------------
    feishu: {
      enabled: true,
      app: {
        // 在飞书开放平台获取
        appId: "YOUR_FEISHU_APP_ID",
        appSecret: "YOUR_FEISHU_APP_SECRET",
        // 事件订阅配置 (在飞书开放平台 -> 事件订阅 中获取)
        verificationToken: "YOUR_VERIFICATION_TOKEN",
        // 加密密钥 (可选，用于消息加密)
        // encryptKey: "YOUR_ENCRYPT_KEY",
      },
      // Webhook 监听端口
      webhookPort: 3001,
      // Webhook 路径
      webhookPath: "/feishu/webhook",
      // 私聊策略: "open" | "allowlist" | "pairing"
      dmPolicy: "pairing",
      // 群聊策略: "open" | "allowlist"
      groupPolicy: "allowlist",
      // 允许的用户 (填入飞书 user_id 或 open_id)
      allowFrom: [
        // "ou_xxxxxx",
      ],
      // 群聊配置
      groups: {
        // 群聊 ID (chat_id)
        // "oc_xxxxxx": {
        //   requireMention: true,  // 是否需要 @机器人
        //   allowFrom: [],         // 允许的发送者
        // },
      },
    },

    // ----------------------------------------------------------------------
    // 钉钉配置 (DingTalk)
    // 应用创建: https://open-dev.dingtalk.com/
    // ----------------------------------------------------------------------
    dingtalk: {
      enabled: true,
      app: {
        // 在钉钉开放平台获取
        appKey: "YOUR_DINGTALK_APP_KEY",
        appSecret: "YOUR_DINGTALK_APP_SECRET",
        // 机器人 Code (可选，用于主动发消息)
        // robotCode: "YOUR_ROBOT_CODE",
        // 消息加签密钥 (可选，用于安全验证)
        // signSecret: "YOUR_SIGN_SECRET",
      },
      // Webhook 监听端口
      webhookPort: 3002,
      // Webhook 路径
      webhookPath: "/dingtalk/webhook",
      // 私聊策略: "open" | "allowlist" | "pairing"
      dmPolicy: "pairing",
      // 群聊策略: "open" | "allowlist"
      groupPolicy: "allowlist",
      // 允许的用户 (填入钉钉 staffId)
      allowFrom: [
        // "user_staffid",
      ],
      // 群聊配置
      groups: {
        // 会话 ID (conversationId)
        // "cidxxxxxx": {
        //   requireMention: true,
        //   allowFrom: [],
        // },
      },
    },
  },

  // ============================================================================
  // 助手配置 (Agent Configuration)
  // ============================================================================
  agent: {
    // 默认模型 (从上面配置的模型中选择)
    // model: "qwen-max",
    // model: "deepseek-chat",
    // model: "glm-4-plus",
  },

  // ============================================================================
  // 插件配置 (Plugins Configuration)
  // ============================================================================
  plugins: {
    // 启用的插件列表
    enabled: [
      "feishu",
      "dingtalk",
      // "openclawwechat",  // 个人微信 (通过 ClawChat 桥接)
    ],

    // 插件独立配置
    entries: {
      // -----------------------------------------------------------------------
      // 个人微信配置 (WeChat Personal via ClawChat Bridge)
      // 获取 API Key: 注册 ClawChat → 我的 → APIKey 管理
      // 无需 VPN，支持文本/图片/视频/文档
      // -----------------------------------------------------------------------
      // openclawwechat: {
      //   enabled: true,
      //   config: {
      //     apiKey: "YOUR_BOT_ID:YOUR_SECRET",  // 在 ClawChat 中获取
      //     // pollIntervalMs: 2000,              // 轮询间隔 (毫秒)
      //     // sessionKey: "agent:main:main",     // 会话标识
      //     // debug: false,                      // 调试模式
      //   },
      // },
    },
  },
}
