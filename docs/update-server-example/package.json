{
  "name": "openclawcn-update-server",
  "version": "1.0.0",
  "description": "OpenClawCN Auto-Update Server",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start dist/server.js --name update-api",
    "pm2:stop": "pm2 stop update-api",
    "pm2:restart": "pm2 restart update-api",
    "pm2:logs": "pm2 logs update-api"
  },
  "dependencies": {
    "ali-oss": "^6.20.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
