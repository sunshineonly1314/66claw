{
  "name": "@openclawcn/nextcloud-talk",
  "version": "2026.2.15",
  "description": "OpenClawCN Nextcloud Talk channel plugin",
  "type": "module",
  "devDependencies": {
    "openclawcn": "workspace:*"
  },
  "openclawcn": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "nextcloud-talk",
      "label": "Nextcloud Talk",
      "selectionLabel": "Nextcloud Talk (self-hosted)",
      "docsPath": "/channels/nextcloud-talk",
      "docsLabel": "nextcloud-talk",
      "blurb": "Self-hosted chat via Nextcloud Talk webhook bots.",
      "aliases": [
        "nc-talk",
        "nc"
      ],
      "order": 65,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclawcn/nextcloud-talk",
      "localPath": "extensions/nextcloud-talk",
      "defaultChoice": "npm"
    }
  }
}
