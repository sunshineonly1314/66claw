{
  "name": "@openclawcn/zalo",
  "version": "2026.2.15",
  "description": "OpenClawCN Zalo channel plugin",
  "type": "module",
  "dependencies": {
    "undici": "7.22.0"
  },
  "devDependencies": {
    "openclawcn": "workspace:*"
  },
  "openclawcn": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "zalo",
      "label": "Zalo",
      "selectionLabel": "Zalo (Bot API)",
      "docsPath": "/channels/zalo",
      "docsLabel": "zalo",
      "blurb": "Vietnam-focused messaging platform with Bot API.",
      "aliases": [
        "zl"
      ],
      "order": 80,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclawcn/zalo",
      "localPath": "extensions/zalo",
      "defaultChoice": "npm"
    }
  }
}
