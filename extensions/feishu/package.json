{
  "name": "@openclawcn/feishu",
  "version": "2026.2.14",
  "description": "OpenClawCN Feishu/Lark channel plugin - 支持 WebSocket/Webhook 连接、媒体处理、卡片渲染",
  "type": "module",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@sinclair/typebox": "0.34.48",
    "axios": "^1.13.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "openclawcn": "workspace:*"
  },
  "openclawcn": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "feishu",
      "label": "Feishu",
      "selectionLabel": "Feishu/Lark (飞书)",
      "docsPath": "/channels/feishu",
      "docsLabel": "feishu",
      "blurb": "飞书/Lark enterprise messaging with doc/wiki/drive tools.",
      "aliases": [
        "lark"
      ],
      "order": 35,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclawcn/feishu",
      "localPath": "extensions/feishu",
      "defaultChoice": "npm"
    }
  }
}
