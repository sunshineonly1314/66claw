/**
 * 微信自动化客服测试配置（带防检测机制）
 *
 * ⚠️ 防封号策略：
 * 1. 随机延迟回复 (2-8秒)
 * 2. 限制每小时回复数量 (≤30条)
 * 3. 模拟人工输入停顿
 * 4. 避免关键词触发
 * 5. 24小时内不超过100条消息
 */
{
  gateway: {
    bind: "loopback",
    port: 18789,
  },

  // ============================================================================
  // 模型配置 - 使用国内可访问的模型
  // ============================================================================
  models: {
    mode: "merge",
    providers: {
      "qwen-dashscope": {
        baseUrl: "https://dashscope.aliyuncs.com/compatible-mode/v1",
        // TODO: 替换为你的 DashScope API Key
        apiKey: "sk-test-placeholder",
        api: "openai-completions",
        models: [
          {
            id: "qwen-max",
            name: "通义千问 Max",
            reasoning: false,
            input: ["text"],
            contextWindow: 32000,
            maxTokens: 500,  // 限制回复长度，避免过长
          },
          {
            id: "qwen-vl-max",
            name: "通义千问 VL Max (视觉)",
            reasoning: false,
            input: ["text", "image"],
            contextWindow: 32000,
            maxTokens: 2000,
          },
        ],
      },
    },
  },

  // ============================================================================
  // 插件配置 - 个人微信
  // ============================================================================
  plugins: {
    enabled: ["openclawwechat"],
    entries: {
      openclawwechat: {
        enabled: true,
        config: {
          // TODO: 替换为你的 ClawChat API Key
          apiKey: "placeholder:placeholder",

          // 轮询间隔：3秒（不要太频繁，避免被检测）
          pollIntervalMs: 3000,

          // 会话配置
          sessionKey: "agent:wechat-safe-bot:main",

          // 调试模式（测试时开启）
          debug: true,

          // ===== 防检测配置 =====
          antiDetection: {
            // 随机延迟回复 (秒)
            replyDelayMin: 2,
            replyDelayMax: 8,

            // 每小时最大回复数量
            maxRepliesPerHour: 30,

            // 24小时最大回复数量
            maxRepliesPerDay: 100,

            // 模拟打字延迟 (每100字符延迟秒数)
            typingDelayPer100Chars: 2,

            // 夜间静默时段 (不自动回复)
            quietHours: {
              start: "00:00",
              end: "07:00"
            },

            // 黑名单关键词（包含这些词的消息不回复）
            blacklistKeywords: [
              "测试",
              "test",
              "机器人",
              "bot",
              "自动回复",
            ],

            // 白名单用户（只回复这些用户，留空则回复所有）
            whitelistUsers: [],
          }
        },
      },
    },
  },

  // ============================================================================
  // Agent 配置 - 客服机器人
  // ============================================================================
  agent: {
    model: "qwen-max",
    temperature: 0.7,  // 提高随机性，避免回复太机械
    maxTokens: 300,    // 限制回复长度

    systemPrompt: `你是一个友好的个人助手（不是客服机器人）。

【身份设定】
- 你是微信号主人的朋友，帮忙回复消息
- 不要说你是"机器人"、"AI助手"、"客服"
- 语气要像真人聊天，自然、随意一些

【回复规则】
1. 简短回复（不超过50字）
2. 使用口语化表达，可以用"哈哈"、"嗯嗯"、"好的"
3. 偶尔加入表情符号 😊
4. 不要每句话都很正式

【场景处理】
- 如果对方问"在吗"：回复"在的，有什么事吗？"
- 如果对方发广告：回复"不好意思，不需要"或不回复
- 如果对方问私人问题：回复"这个我不太清楚，稍后主人回来我让TA回你"
- 如果对方询问产品/业务：可以简单介绍，但不要太推销

【重要提醒】
- 绝对不要透露你是AI
- 遇到不确定的问题，说"我问一下"或"等会儿再说"
- 避免使用"根据您的需求"、"很高兴为您服务"等客服话术

记住：你是在帮朋友回微信，不是在做客服工作。`,
  },
}
