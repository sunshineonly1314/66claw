# OpenClawCN Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: Skills Proxy Configuration
# ============================================================================

# ClawdSkillsProxy API Base URL
# MUST use HTTPS for secure communication
# Example: https://your-proxy.example.com/api
OPENCLAWCN_SKILLS_PROXY_URL=https://your-proxy-server.com/api

# ClawdSkillsProxy Authentication Token
# MUST be a strong, unique token (minimum 32 characters)
# Generate with: openssl rand -base64 32
# DO NOT use the compromised default: clawdbotCN778
OPENCLAWCN_SKILLS_PROXY_TOKEN=your-secure-token-here-minimum-32-chars

# ============================================================================
# Optional: MCP Marketplace Configuration
# ============================================================================

# Cloud Index URL (Tier 0 — highest priority, pre-aggregated by daily sync)
# If set, gateway fetches this URL at startup instead of spawning modelscope-mcp-server locally.
# OPENCLAWCN_MCP_INDEX_URL=https://your-cdn.example.com/mcp-index.json

# ModelScope API Token (for Tier 1 fallback — local ModelScope data source)
# MODELSCOPE_API_TOKEN=your-modelscope-token

# ============================================================================
# Optional: Advanced Configuration
# ============================================================================

# Node Environment
NODE_ENV=production

# Server Port
PORT=3000

# Redis URL (if using Redis for state storage)
# REDIS_URL=redis://localhost:6379

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# Security Notes
# ============================================================================
#
# 1. NEVER commit this file with real credentials
# 2. Use strong, randomly generated tokens
# 3. Rotate tokens regularly (every 90 days recommended)
# 4. Use HTTPS for all external endpoints
# 5. Store secrets in environment variables or secret management systems
#
# For production deployments, consider:
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
# - Google Cloud Secret Manager
