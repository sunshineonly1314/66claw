/**
 * OpenClawCN Security Module - AI Tamper Protection
 * AI 篡改防护
 *
 * 防止 AI Agent（如 Cursor、Claude）被用户指示修改授权检查代码
 *
 * 防护策略：
 * 1. 运行时代码完整性检查 - 检测关键函数是否被篡改
 * 2. 分散验证点 - 多处独立检查，不依赖单一入口
 * 3. 服务端令牌 - API 调用需要服务端签发的短期令牌
 * 4. 行为异常检测 - 检测异常的验证绕过模式
 */

import { createHash, randomBytes } from "node:crypto";
import { createSubsystemLogger } from "../logging/subsystem.js";

const log = createSubsystemLogger("security:ai-tamper");

// ============================================================================
// 1. 运行时代码完整性检查
// ============================================================================

/**
 * 关键函数的源代码指纹
 * 在构建时生成，运行时验证函数是否被修改
 */
interface FunctionFingerprint {
  /** 函数名 */
  name: string;
  /** 函数源代码的哈希 */
  hash: string;
  /** 函数引用（运行时绑定） */
  fn?: () => unknown;
}

// 关键函数的指纹列表（构建时填充）
const FUNCTION_FINGERPRINTS: FunctionFingerprint[] = [];

/**
 * 注册需要保护的函数
 */
export function registerProtectedFunction(
  name: string,
  fn: () => unknown,
): void {
  // 计算函数源代码的哈希
  const source = fn.toString();
  const hash = createHash("sha256").update(source).digest("hex").slice(0, 16);

  FUNCTION_FINGERPRINTS.push({ name, hash, fn });
  log.debug(`Registered protected function: ${name} (${hash})`);
}

/**
 * 验证受保护函数的完整性
 */
export function verifyProtectedFunctions(): {
  valid: boolean;
  tampered: string[];
} {
  const tampered: string[] = [];

  for (const { name, hash, fn } of FUNCTION_FINGERPRINTS) {
    if (!fn) continue;

    const currentSource = fn.toString();
    const currentHash = createHash("sha256")
      .update(currentSource)
      .digest("hex")
      .slice(0, 16);

    if (currentHash !== hash) {
      tampered.push(name);
      log.error(`SECURITY: Function ${name} has been tampered!`);
    }
  }

  return {
    valid: tampered.length === 0,
    tampered,
  };
}

// ============================================================================
// 2. 分散验证检查点
// ============================================================================

/**
 * 验证检查点状态
 */
interface CheckpointState {
  /** 检查点 ID */
  id: string;
  /** 上次验证时间 */
  lastCheck: number;
  /** 验证结果 */
  valid: boolean;
  /** 验证次数 */
  checkCount: number;
}

// 全局检查点状态
const checkpoints = new Map<string, CheckpointState>();

/**
 * 创建验证检查点
 *
 * 在代码的多个位置调用，形成分散的验证网络
 * 任何一个检查点失败都会触发警报
 */
export function verifyCheckpoint(
  checkpointId: string,
  verifyFn: () => boolean,
): boolean {
  const now = Date.now();
  const state = checkpoints.get(checkpointId) || {
    id: checkpointId,
    lastCheck: 0,
    valid: true,
    checkCount: 0,
  };

  try {
    const result = verifyFn();
    state.lastCheck = now;
    state.valid = result;
    state.checkCount++;
    checkpoints.set(checkpointId, state);

    if (!result) {
      log.error(`SECURITY: Checkpoint ${checkpointId} failed!`);
      reportSecurityViolation("checkpoint_failed", { checkpointId });
    }

    return result;
  } catch (error) {
    log.error(`SECURITY: Checkpoint ${checkpointId} error: ${error}`);
    state.valid = false;
    checkpoints.set(checkpointId, state);
    return false;
  }
}

/**
 * 获取所有检查点的状态
 */
export function getCheckpointStatus(): Map<string, CheckpointState> {
  return new Map(checkpoints);
}

// ============================================================================
// 3. 服务端令牌验证
// ============================================================================

/**
 * API 调用令牌
 */
interface ApiToken {
  /** 令牌值 */
  token: string;
  /** 过期时间 */
  expiresAt: number;
  /** 允许的操作 */
  allowedActions: string[];
  /** 签名 */
  signature: string;
}

// 当前有效令牌
let currentApiToken: ApiToken | null = null;

/**
 * 设置 API 令牌（从服务端获取后调用）
 */
export function setApiToken(token: ApiToken): void {
  currentApiToken = token;
  log.debug(`API token set, expires at ${new Date(token.expiresAt).toISOString()}`);
}

/**
 * 验证 API 调用是否有有效令牌
 *
 * @param action - 要执行的操作
 * @returns 是否允许
 */
export function validateApiAction(action: string): boolean {
  if (!currentApiToken) {
    log.debug(`API action ${action} denied: no token`);
    return false;
  }

  // 检查令牌是否过期
  if (Date.now() > currentApiToken.expiresAt) {
    log.debug(`API action ${action} denied: token expired`);
    currentApiToken = null;
    return false;
  }

  // 检查操作是否被允许
  if (!currentApiToken.allowedActions.includes(action) &&
      !currentApiToken.allowedActions.includes("*")) {
    log.debug(`API action ${action} denied: not in allowed actions`);
    return false;
  }

  return true;
}

// ============================================================================
// 4. 行为异常检测
// ============================================================================

/**
 * 异常行为记录
 */
interface AnomalyRecord {
  /** 类型 */
  type: string;
  /** 时间 */
  timestamp: number;
  /** 详情 */
  details: Record<string, unknown>;
}

// 异常行为历史
const anomalyHistory: AnomalyRecord[] = [];
const MAX_ANOMALY_HISTORY = 100;

/**
 * 记录安全违规
 */
export function reportSecurityViolation(
  type: string,
  details: Record<string, unknown> = {},
): void {
  const record: AnomalyRecord = {
    type,
    timestamp: Date.now(),
    details,
  };

  anomalyHistory.push(record);

  // 限制历史记录大小
  if (anomalyHistory.length > MAX_ANOMALY_HISTORY) {
    anomalyHistory.shift();
  }

  log.warn(`Security violation: ${type}`, details);

  // 检查是否触发警报阈值
  checkAnomalyThreshold();
}

/**
 * 检查异常阈值
 */
function checkAnomalyThreshold(): void {
  const recentWindow = 5 * 60 * 1000; // 5 分钟
  const now = Date.now();

  // 统计最近的异常数量
  const recentAnomalies = anomalyHistory.filter(
    (a) => now - a.timestamp < recentWindow,
  );

  // 如果 5 分钟内超过 10 次异常，触发严重警报
  if (recentAnomalies.length >= 10) {
    log.error("SECURITY ALERT: Too many anomalies detected!");
    triggerSecurityAlert("anomaly_threshold_exceeded", {
      count: recentAnomalies.length,
      window: recentWindow,
    });
  }
}

/**
 * 触发安全警报
 */
function triggerSecurityAlert(
  reason: string,
  details: Record<string, unknown>,
): void {
  log.error(`SECURITY ALERT: ${reason}`, details);

  // TODO: 发送到服务端
  // TODO: 可选择禁用功能或退出程序
}

// ============================================================================
// 5. 蜜罐检测
// ============================================================================

/**
 * 创建蜜罐函数
 *
 * 这些函数看起来像是授权检查的入口，但实际上是陷阱
 * 如果被调用或修改，说明有人在尝试绕过授权
 */
export function createHoneypot(name: string): () => boolean {
  const honeypotId = `honeypot_${name}_${randomBytes(4).toString("hex")}`;

  // 记录原始函数哈希
  const originalFn = function _honeypotCheck(): boolean {
    // 这个函数被调用说明有人在探测
    reportSecurityViolation("honeypot_triggered", {
      name,
      honeypotId,
      stack: new Error().stack,
    });
    return false;
  };

  registerProtectedFunction(honeypotId, originalFn);

  return originalFn;
}

// ============================================================================
// 6. 代码完整性自检
// ============================================================================

/**
 * 关键模块路径
 */
const CRITICAL_MODULES = [
  "license/verify",
  "license/heartbeat",
  "license/startup",
  "license/offline",
  "gateway/license-check",
  "security/integrity",
  "security/anti-debug",
  "security/ai-tamper-protection",
];

/**
 * 执行全面的安全自检
 */
export async function performSecuritySelfCheck(): Promise<{
  passed: boolean;
  issues: string[];
}> {
  const issues: string[] = [];

  // 1. 检查受保护函数
  const fnCheck = verifyProtectedFunctions();
  if (!fnCheck.valid) {
    issues.push(`Tampered functions: ${fnCheck.tampered.join(", ")}`);
  }

  // 2. 检查检查点状态
  for (const [id, state] of checkpoints) {
    if (!state.valid) {
      issues.push(`Failed checkpoint: ${id}`);
    }
  }

  // 3. 检查异常历史
  const recentAnomalies = anomalyHistory.filter(
    (a) => Date.now() - a.timestamp < 60 * 60 * 1000, // 1 小时内
  );
  if (recentAnomalies.length > 5) {
    issues.push(`High anomaly count: ${recentAnomalies.length} in last hour`);
  }

  const passed = issues.length === 0;

  if (!passed) {
    log.error("Security self-check FAILED", { issues });
  } else {
    log.debug("Security self-check passed");
  }

  return { passed, issues };
}

// ============================================================================
// 7. 导出统一的防护接口
// ============================================================================

/**
 * 初始化 AI 篡改防护
 */
export function initAiTamperProtection(): void {
  log.info("Initializing AI tamper protection");

  // 创建蜜罐函数
  createHoneypot("license_check");
  createHoneypot("verify_key");
  createHoneypot("skip_validation");

  // 注册定期自检
  setInterval(() => {
    performSecuritySelfCheck().catch((err) => {
      log.error(`Security self-check error: ${err}`);
    });
  }, 5 * 60 * 1000); // 每 5 分钟

  log.info("AI tamper protection initialized");
}
