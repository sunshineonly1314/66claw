/**
 * Generates a lightweight loading page shown while the gateway completes
 * initialisation.  The page polls `/api/health` and redirects to `/` once
 * the gateway reports `ready: true`.
 */
export function generateLoadingPageHtml(): string {
  return `<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>OpenClawCN - 启动中</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
       background:#0f0f11;color:#e0e0e0;display:flex;align-items:center;
       justify-content:center;min-height:100vh}
  .container{text-align:center;max-width:400px;padding:2rem}
  .spinner{width:48px;height:48px;border:4px solid #333;border-top-color:#6366f1;
           border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 1.5rem}
  @keyframes spin{to{transform:rotate(360deg)}}
  h1{font-size:1.25rem;font-weight:500;margin-bottom:0.5rem}
  p{color:#888;font-size:0.875rem;line-height:1.5}
  .phase{color:#6366f1;font-weight:500;margin-top:1rem;min-height:1.2em}
</style>
</head>
<body>
<div class="container">
  <div class="spinner"></div>
  <h1>正在启动服务</h1>
  <p>服务正在初始化各组件，就绪后将自动跳转。</p>
  <div class="phase" id="phase">初始化中...</div>
</div>
<script>
(function poll(){
  var el=document.getElementById("phase");
  fetch("/api/health").then(function(r){
    if(!r.ok) throw new Error("HTTP "+r.status);
    return r.json();
  }).then(function(d){
    if(d.ready){location.replace(location.pathname+location.search)}
    else{el.textContent=d.phase||"初始化中..."}
  }).catch(function(){
    el.textContent="正在连接...";
  });
  setTimeout(poll,1500);
})();
</script>
</body>
</html>`;
}
