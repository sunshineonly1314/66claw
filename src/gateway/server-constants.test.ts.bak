import { describe, expect, it } from "vitest";

import {
  WS_PING_INTERVAL_MS,
  WS_PING_MAX_MISSED,
  MAX_PAYLOAD_BYTES,
  MAX_BUFFERED_BYTES,
  TICK_INTERVAL_MS,
  HEALTH_REFRESH_INTERVAL_MS,
  DEDUPE_TTL_MS,
  DEDUPE_MAX,
  DEFAULT_HANDSHAKE_TIMEOUT_MS,
  getHandshakeTimeoutMs,
} from "./server-constants.js";

describe("server-constants", () => {
  // ── WebSocket Ping/Pong constants ──────────────────────────────────
  describe("WS_PING_INTERVAL_MS", () => {
    it("is a positive number", () => {
      expect(WS_PING_INTERVAL_MS).toBeGreaterThan(0);
    });

    it("is 45 seconds", () => {
      expect(WS_PING_INTERVAL_MS).toBe(45_000);
    });

    it("is different from TICK_INTERVAL_MS to avoid burst", () => {
      expect(WS_PING_INTERVAL_MS).not.toBe(TICK_INTERVAL_MS);
    });

    it("is greater than TICK_INTERVAL_MS (offset design)", () => {
      expect(WS_PING_INTERVAL_MS).toBeGreaterThan(TICK_INTERVAL_MS);
    });
  });

  describe("WS_PING_MAX_MISSED", () => {
    it("is a positive integer", () => {
      expect(WS_PING_MAX_MISSED).toBeGreaterThan(0);
      expect(Number.isInteger(WS_PING_MAX_MISSED)).toBe(true);
    });

    it("is 3", () => {
      expect(WS_PING_MAX_MISSED).toBe(3);
    });

    it("total timeout is reasonable (> 2 minutes)", () => {
      const totalTimeoutMs = WS_PING_INTERVAL_MS * WS_PING_MAX_MISSED;
      expect(totalTimeoutMs).toBeGreaterThan(2 * 60_000);
    });
  });

  // ── Existing constants (regression) ────────────────────────────────
  describe("existing constants remain unchanged", () => {
    it("MAX_PAYLOAD_BYTES is 8 MiB", () => {
      expect(MAX_PAYLOAD_BYTES).toBe(8 * 1024 * 1024);
    });

    it("MAX_BUFFERED_BYTES is 16 MiB (2x payload)", () => {
      expect(MAX_BUFFERED_BYTES).toBe(16 * 1024 * 1024);
    });

    it("TICK_INTERVAL_MS is 30 seconds", () => {
      expect(TICK_INTERVAL_MS).toBe(30_000);
    });

    it("HEALTH_REFRESH_INTERVAL_MS is 60 seconds", () => {
      expect(HEALTH_REFRESH_INTERVAL_MS).toBe(60_000);
    });

    it("DEDUPE_TTL_MS is 5 minutes", () => {
      expect(DEDUPE_TTL_MS).toBe(5 * 60_000);
    });

    it("DEDUPE_MAX is 1000", () => {
      expect(DEDUPE_MAX).toBe(1000);
    });

    it("DEFAULT_HANDSHAKE_TIMEOUT_MS is 10 seconds", () => {
      expect(DEFAULT_HANDSHAKE_TIMEOUT_MS).toBe(10_000);
    });

    it("getHandshakeTimeoutMs returns default outside tests", () => {
      // In vitest the env override may apply; just ensure it's a positive number
      expect(getHandshakeTimeoutMs()).toBeGreaterThan(0);
    });
  });
});
