/**
 * Security Mode API Handlers
 * 安全模式配置 API - 获取和设置 AI 能力范围
 */

import {
  ErrorCodes,
  errorShape,
} from "../protocol/index.js";
import { loadConfig, writeConfigFile } from "../../config/config.js";
import { CN_DEFAULT_SECURITY_CONFIG } from "../../config/region-cn.js";
import type { OpenClawCNConfig } from "../../config/config.js";
import type { GatewayRequestHandlers } from "./types.js";

/**
 * 安全模式类型
 * - trust: 完全信任，无任何限制（危险）
 * - standard: 正常使用，推荐模式
 * - full: 只聊天，绝对安全
 */
export type SecurityMode = "trust" | "standard" | "full";

/**
 * 安全模式配置信息
 */
export interface SecurityModeInfo {
  id: SecurityMode;
  name: string;
  description: string;
  icon: string;
  /** 是否为推荐模式 */
  recommended?: boolean;
  /** 是否需要确认警告 */
  dangerous?: boolean;
  /** 功能列表 */
  features: Array<{
    text: string;
    type: "positive" | "neutral" | "warning" | "danger";
  }>;
}

/**
 * 获取所有可用的安全模式
 */
function getSecurityModes(): SecurityModeInfo[] {
  return [
    {
      id: "trust",
      name: "完全信任",
      description: "解锁全部能力，AI 可以帮你做任何事",
      icon: "⚡",
      dangerous: true,
      features: [
        { text: "无任何限制，AI 可访问整个系统", type: "positive" },
        { text: "自动执行复杂任务，效率最高", type: "positive" },
        { text: "有风险，仅建议开发者或独立测试设备使用", type: "danger" },
      ],
    },
    {
      id: "standard",
      name: "正常使用",
      description: "推荐模式，平衡安全与能力",
      icon: "🏠",
      recommended: true,
      features: [
        { text: "AI 可在指定目录内读写文件", type: "positive" },
        { text: "安全命令白名单，未知命令需确认", type: "neutral" },
        { text: "平衡安全与能力，适合日常使用", type: "positive" },
      ],
    },
    {
      id: "full",
      name: "只聊天",
      description: "绝对安全模式，AI 完全无法操作你的电脑",
      icon: "🔒",
      features: [
        { text: "AI 只能聊天，无法执行任何操作", type: "neutral" },
        { text: "完全安全，适合敏感环境", type: "positive" },
        { text: "功能受限，无法帮你处理文件或执行命令", type: "warning" },
      ],
    },
  ];
}

/**
 * 从配置中推断当前安全模式
 */
function inferSecurityMode(config: OpenClawCNConfig): SecurityMode {
  const sandbox = config.agents?.defaults?.sandbox;
  const exec = config.tools?.exec;

  // 完全信任模式：无沙盒限制且 exec security 为 full
  if (exec?.security === "full") {
    return "trust";
  }

  // 只聊天模式：exec security 为 deny
  if (exec?.security === "deny") {
    return "full";
  }

  // 默认为标准模式
  return "standard";
}

/**
 * 应用安全模式配置
 */
function applySecurityMode(config: OpenClawCNConfig, mode: SecurityMode): OpenClawCNConfig {
  let nextConfig: OpenClawCNConfig = { ...config };

  switch (mode) {
    case "trust":
      // 完全信任模式：移除所有限制
      nextConfig = {
        ...nextConfig,
        agents: {
          ...nextConfig.agents,
          defaults: {
            ...nextConfig.agents?.defaults,
            sandbox: undefined, // 不使用沙盒
          },
        },
        tools: {
          ...nextConfig.tools,
          exec: {
            ...nextConfig.tools?.exec,
            security: "full", // 允许执行任何命令
            ask: "off", // 不询问确认
          },
        },
      };
      break;

    case "standard":
      // 标准模式：应用推荐的安全配置
      nextConfig = {
        ...nextConfig,
        agents: {
          ...nextConfig.agents,
          defaults: {
            ...nextConfig.agents?.defaults,
            sandbox: {
              ...CN_DEFAULT_SECURITY_CONFIG.sandbox,
              // 保留现有的 docker binds
              docker: nextConfig.agents?.defaults?.sandbox?.docker,
            },
          },
        },
        tools: {
          ...nextConfig.tools,
          exec: {
            ...nextConfig.tools?.exec,
            security: "allowlist",
            ask: "on-miss", // 未知命令询问用户
            // 预置常用命令白名单
            safeBins: [
              // Windows 常用
              "notepad", "explorer", "calc", "mspaint", "code", "cmd", "powershell",
              "start", "where", "dir", "type", "echo", "set", "cd", "mkdir", "copy",
              // 开发工具 - 通用
              "python", "python3", "pip", "pip3",
              "node", "npm", "pnpm", "yarn", "bun",
              "git", "curl", "wget",
              // 开发工具 - Java
              "java", "javac", "mvn", "gradle",
              // 开发工具 - 其他语言
              "go", "cargo", "dotnet",
              // 压缩工具
              "tar", "zip", "unzip",
              // Linux 基础
              "ls", "cat", "grep", "find", "head", "tail", "wc", "sort", "uniq", "jq",
              "cp", "mv", "mkdir", "touch", "chmod", "pwd", "which", "env",
              // 浏览器
              "chrome", "msedge", "firefox",
            ],
          },
        },
      };
      break;

    case "full":
      // 只聊天模式：禁止所有操作
      nextConfig = {
        ...nextConfig,
        tools: {
          ...nextConfig.tools,
          exec: {
            ...nextConfig.tools?.exec,
            security: "deny", // 禁止执行命令
          },
        },
      };
      break;
  }

  return nextConfig;
}

export const securityHandlers: GatewayRequestHandlers = {
  /**
   * 获取可用的安全模式列表和当前模式
   */
  "security.modes": async ({ respond }) => {
    try {
      const modes = getSecurityModes();
      const config = loadConfig();
      const current = inferSecurityMode(config);

      respond(true, {
        modes,
        current,
      }, undefined);
    } catch (err) {
      respond(false, undefined, errorShape(ErrorCodes.UNAVAILABLE, String(err)));
    }
  },

  /**
   * 设置安全模式
   */
  "security.setMode": async ({ params, respond }) => {
    try {
      const p = params as { mode?: SecurityMode; confirmed?: boolean };

      if (!p.mode) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "missing mode parameter"),
        );
        return;
      }

      // 验证模式是否有效
      const validModes: SecurityMode[] = ["trust", "standard", "full"];
      if (!validModes.includes(p.mode)) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, `invalid mode: ${p.mode}`),
        );
        return;
      }

      // 完全信任模式需要确认
      if (p.mode === "trust" && !p.confirmed) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "trust mode requires confirmation"),
        );
        return;
      }

      // 应用安全模式
      const config = loadConfig();
      const nextConfig = applySecurityMode(config, p.mode);
      await writeConfigFile(nextConfig);

      respond(true, {
        ok: true,
        mode: p.mode,
      }, undefined);
    } catch (err) {
      respond(false, undefined, errorShape(ErrorCodes.UNAVAILABLE, String(err)));
    }
  },
};
