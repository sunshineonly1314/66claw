import {
  SkillInstallApprovalManager,
  type SkillInstallDecision,
  type SkillInstallRequestPayload,
} from "../skill-install-approval-manager.js";
import { ErrorCodes, errorShape } from "../protocol/index.js";
import type { GatewayRequestHandlers } from "./types.js";

// 单例 manager 实例
let skillInstallManager: SkillInstallApprovalManager | null = null;

/**
 * 获取技能安装审批管理器单例
 */
export function getSkillInstallApprovalManager(): SkillInstallApprovalManager {
  if (!skillInstallManager) {
    skillInstallManager = new SkillInstallApprovalManager();
  }
  return skillInstallManager;
}

/**
 * 验证技能安装请求参数
 */
function validateSkillInstallRequestParams(
  params: unknown,
): params is {
  id?: string;
  skillName: string;
  skillDescription?: string;
  missing?: { bins?: string[]; env?: string[]; config?: string[] };
  installSteps?: string[];
  estimatedTime?: string;
  originalMessage?: string;
  runId?: string;
  sessionKey?: string;
  agentId?: string;
  timeoutMs?: number;
} {
  if (!params || typeof params !== "object") return false;
  const p = params as Record<string, unknown>;
  if (typeof p.skillName !== "string" || p.skillName.trim().length === 0) {
    return false;
  }
  return true;
}

/**
 * 验证技能安装决策参数
 */
function validateSkillInstallResolveParams(
  params: unknown,
): params is { id: string; decision: string } {
  if (!params || typeof params !== "object") return false;
  const p = params as Record<string, unknown>;
  if (typeof p.id !== "string" || p.id.trim().length === 0) return false;
  if (typeof p.decision !== "string") return false;
  return true;
}

/**
 * OpenClawCN 专属：安装进度回调类型
 */
export type SkillInstallProgressInfo = {
  stage: "downloading" | "installing" | "verifying";
  message: string;
  percent?: number;
  currentDependency?: string;
  downloadInfo?: {
    speed?: string;
    eta?: string;
    downloaded?: string;
    total?: string;
  };
  usingCNMirror?: boolean;
};

export type SkillInstallHandlerOptions = {
  /**
   * 安装技能的回调函数
   */
  onInstall?: (
    skillName: string,
    options: {
      recordId: string;
      continueAfterInstall: boolean;
      originalMessage?: string | null;
      sessionKey?: string | null;
      /** OpenClawCN 专属：进度回调 */
      onProgress?: (progress: SkillInstallProgressInfo) => void;
    },
  ) => Promise<{ success: boolean; error?: string }>;

  /**
   * 安装完成后继续执行原始指令的回调
   */
  onContinueExecution?: (options: {
    sessionKey: string;
    originalMessage: string;
    skillName: string;
  }) => Promise<void>;
};

/**
 * 创建技能安装审批处理器
 */
export function createSkillInstallApprovalHandlers(
  manager: SkillInstallApprovalManager,
  opts?: SkillInstallHandlerOptions,
): GatewayRequestHandlers {
  return {
    /**
     * 请求安装技能
     * 由 Agent 在检测到技能缺失时调用
     */
    "skill.install.request": async ({ params, respond, context }) => {
      if (!validateSkillInstallRequestParams(params)) {
        respond(
          false,
          undefined,
          errorShape(
            ErrorCodes.INVALID_REQUEST,
            "invalid skill.install.request params: skillName is required",
          ),
        );
        return;
      }

      const p = params;
      const timeoutMs = typeof p.timeoutMs === "number" ? p.timeoutMs : 300_000; // 5分钟超时
      const explicitId =
        typeof p.id === "string" && p.id.trim().length > 0 ? p.id.trim() : null;

      if (explicitId && manager.getSnapshot(explicitId)) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "approval id already pending"),
        );
        return;
      }

      // 检查同一技能是否已经在安装队列中
      if (manager.isSkillPendingOrInstalling(p.skillName)) {
        respond(
          false,
          undefined,
          errorShape(
            ErrorCodes.INVALID_REQUEST,
            `skill "${p.skillName}" is already pending or installing`,
          ),
        );
        return;
      }

      const request: SkillInstallRequestPayload = {
        skillName: p.skillName,
        skillDescription: p.skillDescription ?? null,
        missing: {
          bins: p.missing?.bins ?? [],
          env: p.missing?.env ?? [],
          config: p.missing?.config ?? [],
        },
        installSteps: p.installSteps ?? null,
        estimatedTime: p.estimatedTime ?? null,
        originalMessage: p.originalMessage ?? null,
        runId: p.runId ?? null,
        sessionKey: p.sessionKey ?? null,
        agentId: p.agentId ?? null,
      };

      const record = manager.create(request, timeoutMs, explicitId);
      const decisionPromise = manager.waitForDecision(record, timeoutMs);

      // 广播安装请求事件给所有连接的客户端
      context.broadcast(
        "skill.install.requested",
        {
          id: record.id,
          request: record.request,
          createdAtMs: record.createdAtMs,
          expiresAtMs: record.expiresAtMs,
        },
        { dropIfSlow: true },
      );

      const decision = await decisionPromise;

      respond(
        true,
        {
          id: record.id,
          decision,
          createdAtMs: record.createdAtMs,
          expiresAtMs: record.expiresAtMs,
        },
        undefined,
      );
    },

    /**
     * 解析用户对安装请求的决策
     * 由 UI 在用户点击安装/取消按钮时调用
     */
    "skill.install.resolve": async ({ params, respond, client, context }) => {
      if (!validateSkillInstallResolveParams(params)) {
        respond(
          false,
          undefined,
          errorShape(
            ErrorCodes.INVALID_REQUEST,
            "invalid skill.install.resolve params: id and decision are required",
          ),
        );
        return;
      }

      const p = params;
      const decision = p.decision as SkillInstallDecision;

      if (
        decision !== "install" &&
        decision !== "install-continue" &&
        decision !== "deny"
      ) {
        respond(
          false,
          undefined,
          errorShape(
            ErrorCodes.INVALID_REQUEST,
            "invalid decision: must be 'install', 'install-continue', or 'deny'",
          ),
        );
        return;
      }

      const snapshot = manager.getSnapshot(p.id);
      const resolvedBy =
        client?.connect?.client?.displayName ?? client?.connect?.client?.id;
      const ok = manager.resolve(p.id, decision, resolvedBy ?? null);

      if (!ok) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "unknown approval id"),
        );
        return;
      }

      // 广播决策结果
      context.broadcast(
        "skill.install.resolved",
        { id: p.id, decision, resolvedBy, ts: Date.now() },
        { dropIfSlow: true },
      );

      // 立即响应，不阻塞 UI
      respond(true, { ok: true }, undefined);

      // 如果用户选择安装，异步执行安装（不阻塞 RPC）
      if (
        (decision === "install" || decision === "install-continue") &&
        snapshot &&
        opts?.onInstall
      ) {
        // 使用 setImmediate 确保响应先发送，安装异步执行
        setImmediate(async () => {
          // 广播安装开始
          context.broadcast(
            "skill.install.progress",
            {
              id: p.id,
              stage: "downloading",
              message: `正在下载技能 ${snapshot.request.skillName}...`,
              percent: 0,
            },
            { dropIfSlow: true },
          );

          try {
            // OpenClawCN 专属：传入进度回调，实时广播安装进度
            const result = await opts.onInstall!(snapshot.request.skillName, {
              recordId: p.id,
              continueAfterInstall: decision === "install-continue",
              originalMessage: snapshot.request.originalMessage,
              sessionKey: snapshot.request.sessionKey,
              onProgress: (progress) => {
                // 实时广播进度到 UI
                context.broadcast(
                  "skill.install.progress",
                  {
                    id: p.id,
                    skillName: snapshot.request.skillName,
                    stage: progress.stage,
                    message: progress.message,
                    percent: progress.percent,
                    currentDependency: progress.currentDependency,
                    downloadInfo: progress.downloadInfo,
                    usingCNMirror: progress.usingCNMirror,
                  },
                  { dropIfSlow: true },
                );
              },
            });

            if (result.success) {
              // 广播安装成功
              context.broadcast(
                "skill.install.progress",
                {
                  id: p.id,
                  stage: "complete",
                  message: `技能 ${snapshot.request.skillName} 安装成功！`,
                  percent: 100,
                },
                { dropIfSlow: true },
              );

              // 如果用户选择安装并继续，触发继续执行
              if (
                decision === "install-continue" &&
                snapshot.request.sessionKey &&
                snapshot.request.originalMessage &&
                opts.onContinueExecution
              ) {
                try {
                  await opts.onContinueExecution({
                    sessionKey: snapshot.request.sessionKey,
                    originalMessage: snapshot.request.originalMessage,
                    skillName: snapshot.request.skillName,
                  });
                } catch (continueErr) {
                  // 继续执行失败不影响安装结果
                  context.logGateway?.error?.(
                    `skill install: continue execution failed: ${String(continueErr)}`,
                  );
                }
              }
            } else {
              // 广播安装失败
              context.broadcast(
                "skill.install.progress",
                {
                  id: p.id,
                  stage: "failed",
                  message: result.error ?? "安装失败",
                  percent: 0,
                },
                { dropIfSlow: true },
              );
            }
          } catch (err) {
            const errorMsg = err instanceof Error ? err.message : String(err);
            context.broadcast(
              "skill.install.progress",
              {
                id: p.id,
                stage: "failed",
                message: errorMsg,
                percent: 0,
              },
              { dropIfSlow: true },
            );
          }
        });
      }
    },

    /**
     * 获取待处理的安装请求列表
     */
    "skill.install.pending": async ({ respond }) => {
      const pending = manager.getPendingRequests();
      respond(true, { requests: pending }, undefined);
    },

    /**
     * 取消安装请求
     */
    "skill.install.cancel": async ({ params, respond, context }) => {
      if (
        !params ||
        typeof params !== "object" ||
        typeof (params as Record<string, unknown>).id !== "string"
      ) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "id is required"),
        );
        return;
      }

      const p = params as { id: string };
      const ok = manager.cancel(p.id);

      if (!ok) {
        respond(
          false,
          undefined,
          errorShape(ErrorCodes.INVALID_REQUEST, "unknown approval id"),
        );
        return;
      }

      context.broadcast(
        "skill.install.cancelled",
        { id: p.id, ts: Date.now() },
        { dropIfSlow: true },
      );

      respond(true, { ok: true }, undefined);
    },
  };
}

/**
 * 静态导出的技能安装处理器（使用单例 manager）
 * 注意：onInstall 回调需要在运行时通过 setSkillInstallCallback 设置
 */
let installCallback: SkillInstallHandlerOptions["onInstall"] | null = null;
let continueCallback: SkillInstallHandlerOptions["onContinueExecution"] | null = null;

/**
 * 设置技能安装回调
 */
export function setSkillInstallCallbacks(opts: SkillInstallHandlerOptions): void {
  installCallback = opts.onInstall ?? null;
  continueCallback = opts.onContinueExecution ?? null;
}

/**
 * 静态导出的技能安装处理器
 */
export const skillInstallApprovalHandlers: GatewayRequestHandlers = {
  "skill.install.request": async (handlerOpts) => {
    const manager = getSkillInstallApprovalManager();
    const handlers = createSkillInstallApprovalHandlers(manager, {
      onInstall: installCallback ?? undefined,
      onContinueExecution: continueCallback ?? undefined,
    });
    return handlers["skill.install.request"]!(handlerOpts);
  },
  "skill.install.resolve": async (handlerOpts) => {
    const manager = getSkillInstallApprovalManager();
    const handlers = createSkillInstallApprovalHandlers(manager, {
      onInstall: installCallback ?? undefined,
      onContinueExecution: continueCallback ?? undefined,
    });
    return handlers["skill.install.resolve"]!(handlerOpts);
  },
  "skill.install.pending": async (handlerOpts) => {
    const manager = getSkillInstallApprovalManager();
    const handlers = createSkillInstallApprovalHandlers(manager);
    return handlers["skill.install.pending"]!(handlerOpts);
  },
  "skill.install.cancel": async (handlerOpts) => {
    const manager = getSkillInstallApprovalManager();
    const handlers = createSkillInstallApprovalHandlers(manager);
    return handlers["skill.install.cancel"]!(handlerOpts);
  },
};
