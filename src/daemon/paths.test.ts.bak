import path from "node:path";
import { describe, expect, it } from "vitest";
import { resolveGatewayStateDir } from "./paths.js";

describe("resolveGatewayStateDir", () => {
  it("uses the default state dir when no overrides are set", () => {
    const env = { HOME: "/Users/test" };
    expect(resolveGatewayStateDir(env)).toBe(path.join("/Users/test", ".openclawcn"));
  });

  it("appends the profile suffix when set", () => {
    const env = { HOME: "/Users/test", OPENCLAWCN_PROFILE: "rescue" };
    expect(resolveGatewayStateDir(env)).toBe(path.join("/Users/test", ".openclawcn-rescue"));
  });

  it("treats default profiles as the base state dir", () => {
    const env = { HOME: "/Users/test", OPENCLAWCN_PROFILE: "Default" };
    expect(resolveGatewayStateDir(env)).toBe(path.join("/Users/test", ".openclawcn"));
  });

  it("uses OPENCLAWCN_STATE_DIR when provided", () => {
    const env = { HOME: "/Users/test", OPENCLAWCN_STATE_DIR: "/var/lib/openclawcn" };
    expect(resolveGatewayStateDir(env)).toBe(path.resolve("/var/lib/openclawcn"));
  });

  it("expands ~ in OPENCLAWCN_STATE_DIR", () => {
    const env = { HOME: "/Users/test", OPENCLAWCN_STATE_DIR: "~/openclawcn-state" };
    expect(resolveGatewayStateDir(env)).toBe(path.resolve("/Users/test/openclawcn-state"));
  });

  it("preserves Windows absolute paths without HOME", () => {
    const env = { OPENCLAWCN_STATE_DIR: "C:\\State\\openclawcn" };
    expect(resolveGatewayStateDir(env)).toBe("C:\\State\\openclawcn");
  });
});
