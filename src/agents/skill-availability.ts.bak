import { resolveAgentWorkspaceDir, resolveDefaultAgentId } from "./agent-scope.js";
import { buildWorkspaceSkillStatus, type SkillStatusEntry } from "./skills-status.js";
import { loadConfig, type OpenClawCNConfig } from "../config/config.js";
import type { SkillEntry } from "./skills.js";

/**
 * 技能可用性检查结果
 */
export interface SkillAvailabilityResult {
  /** 技能是否可用（eligible） */
  available: boolean;
  /** 是否可以自动安装 */
  canAutoInstall: boolean;
  /** 技能状态条目 */
  status: SkillStatusEntry | null;
  /** 缺失的依赖信息 */
  missing: {
    bins: string[];
    env: string[];
    config: string[];
  };
  /** 安装说明 */
  installHint?: string;
}

/**
 * 根据工具名称查找对应的技能
 */
export function findSkillByToolName(
  toolName: string,
  entries: SkillEntry[],
): SkillEntry | null {
  // 尝试按技能名匹配
  for (const entry of entries) {
    if (entry.skill.name === toolName) {
      return entry;
    }
    // 按技能 key 匹配
    if (entry.metadata?.skillKey === toolName) {
      return entry;
    }
  }

  return null;
}

/**
 * 检查技能是否可用
 */
export function checkSkillAvailability(
  skillName: string,
  config?: OpenClawCNConfig,
): SkillAvailabilityResult {
  const cfg = config ?? loadConfig();
  const workspaceDir = resolveAgentWorkspaceDir(cfg, resolveDefaultAgentId(cfg));
  const report = buildWorkspaceSkillStatus(workspaceDir, { config: cfg });

  // 查找技能状态
  const status = report.skills.find(
    (s) => s.name === skillName || s.skillKey === skillName,
  );

  if (!status) {
    return {
      available: false,
      canAutoInstall: false,
      status: null,
      missing: { bins: [], env: [], config: [] },
      installHint: `技能 "${skillName}" 未找到`,
    };
  }

  // 检查是否可用
  if (status.eligible) {
    return {
      available: true,
      canAutoInstall: false,
      status,
      missing: { bins: [], env: [], config: [] },
    };
  }

  // 收集缺失的依赖
  const missing = {
    bins: status.missing.bins,
    env: status.missing.env,
    config: status.missing.config,
  };

  // 检查是否可以自动安装
  // 仅当缺失二进制文件且有安装选项时才能自动安装
  const hasInstallOptions = status.install.length > 0;
  const onlyMissingBins =
    missing.bins.length > 0 && missing.env.length === 0 && missing.config.length === 0;
  const canAutoInstall = hasInstallOptions && onlyMissingBins;

  // 生成安装提示
  let installHint: string | undefined;
  if (missing.bins.length > 0) {
    const binsHint = missing.bins.join(", ");
    if (hasInstallOptions) {
      installHint = `缺少命令行工具: ${binsHint}。可以通过 ClawbotCN 自动安装。`;
    } else {
      installHint = `缺少命令行工具: ${binsHint}。请手动安装后重试。`;
    }
  } else if (missing.env.length > 0) {
    installHint = `缺少环境变量: ${missing.env.join(", ")}。请配置后重试。`;
  } else if (missing.config.length > 0) {
    installHint = `缺少配置项: ${missing.config.join(", ")}。请在设置中配置。`;
  }

  return {
    available: false,
    canAutoInstall,
    status,
    missing,
    installHint,
  };
}

/**
 * 批量检查多个技能的可用性
 */
export function checkMultipleSkillsAvailability(
  skillNames: string[],
  config?: OpenClawCNConfig,
): Map<string, SkillAvailabilityResult> {
  const results = new Map<string, SkillAvailabilityResult>();

  for (const name of skillNames) {
    results.set(name, checkSkillAvailability(name, config));
  }

  return results;
}

/**
 * 获取所有不可用但可自动安装的技能
 */
export function getAutoInstallableSkills(
  config?: OpenClawCNConfig,
): SkillStatusEntry[] {
  const cfg = config ?? loadConfig();
  const workspaceDir = resolveAgentWorkspaceDir(cfg, resolveDefaultAgentId(cfg));
  const report = buildWorkspaceSkillStatus(workspaceDir, { config: cfg });

  return report.skills.filter((skill) => {
    if (skill.eligible) return false;
    if (skill.install.length === 0) return false;
    // 仅当缺失二进制文件时可自动安装
    return (
      skill.missing.bins.length > 0 &&
      skill.missing.env.length === 0 &&
      skill.missing.config.length === 0
    );
  });
}

/**
 * 创建技能安装请求载荷
 */
export function createSkillInstallRequestPayload(
  status: SkillStatusEntry,
  originalMessage?: string,
  sessionKey?: string,
): {
  skillName: string;
  skillDescription: string;
  missing: {
    bins: string[];
    env: string[];
    config: string[];
  };
  installSteps: string[];
  estimatedTime: string;
  originalMessage?: string;
  sessionKey?: string;
} {
  // 生成安装步骤预览
  const installSteps: string[] = [];

  for (const option of status.install) {
    switch (option.kind) {
      case "brew":
        installSteps.push(`使用 Homebrew 安装: brew install ${option.label}`);
        break;
      case "node":
        installSteps.push(`使用 npm 安装: npm install -g ${option.label}`);
        break;
      case "go":
        installSteps.push(`使用 Go 安装: go install ${option.label}`);
        break;
      case "uv":
        installSteps.push(`使用 uv 安装: uv tool install ${option.label}`);
        break;
      case "download":
        installSteps.push(`下载并安装: ${option.label}`);
        break;
      default:
        installSteps.push(`安装 ${option.label}`);
    }
  }

  // 估计安装时间
  const binCount = status.missing.bins.length;
  const estimatedTime =
    binCount === 0
      ? "< 1 分钟"
      : binCount <= 2
        ? "1-2 分钟"
        : binCount <= 5
          ? "2-5 分钟"
          : "5-10 分钟";

  return {
    skillName: status.name,
    skillDescription: status.description,
    missing: {
      bins: status.missing.bins,
      env: status.missing.env,
      config: status.missing.config,
    },
    installSteps,
    estimatedTime,
    originalMessage,
    sessionKey,
  };
}
