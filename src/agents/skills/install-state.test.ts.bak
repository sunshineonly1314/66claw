/**
 * Tests for install-state.ts
 * Covers: async mutex serialization, Windows rename safety, CRUD operations
 */

import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import fs from "node:fs";
import path from "node:path";
import os from "node:os";

// We need to mock CONFIG_DIR before importing the module under test
let tmpDir: string;

vi.mock("../../utils.js", async () => {
  return {
    get CONFIG_DIR() { return tmpDir; },
    ensureDir: async (dir: string) => { await fs.promises.mkdir(dir, { recursive: true }); },
  };
});

const {
  loadInstallState,
  saveInstallState,
  markSkillInstalled,
  markSkillPartial,
  clearPartialDownload,
  getPartialDownload,
  dismissBanner,
  isBannerDismissed,
  recordBatchInstallTimestamp,
  pruneStalePartials,
  getInstallStateSummary,
} = await import("./install-state.js");

describe("install-state", () => {
  beforeEach(async () => {
    tmpDir = await fs.promises.mkdtemp(path.join(os.tmpdir(), "openclawcn-state-test-"));
  });

  afterEach(async () => {
    await fs.promises.rm(tmpDir, { recursive: true, force: true });
  });

  // -------------------------------------------------------------------
  // Basic CRUD
  // -------------------------------------------------------------------

  it("returns empty state when no file exists", () => {
    const state = loadInstallState();
    expect(state.version).toBe("1.0.0");
    expect(Object.keys(state.installed)).toHaveLength(0);
    expect(Object.keys(state.partial)).toHaveLength(0);
  });

  it("markSkillInstalled persists a record and can be read back", async () => {
    await markSkillInstalled("test-skill", {
      version: "1.0.0",
      installed_at: "2025-01-01T00:00:00Z",
      method: "batch",
      mirror_used: "https://npmmirror.com",
      size_bytes: 1024,
    });

    const state = loadInstallState();
    expect(state.installed["test-skill"]).toBeDefined();
    expect(state.installed["test-skill"].version).toBe("1.0.0");
    expect(state.installed["test-skill"].mirror_used).toBe("https://npmmirror.com");
  });

  it("markSkillInstalled clears partial record for same skill", async () => {
    await markSkillPartial("test-skill", {
      bytes_downloaded: 500,
      bytes_total: 1000,
      partial_path: path.join(tmpDir, "test.partial"),
      started_at: new Date().toISOString(),
    });

    // Create the partial file
    await fs.promises.writeFile(path.join(tmpDir, "test.partial"), "partial-data");

    let state = loadInstallState();
    expect(state.partial["test-skill"]).toBeDefined();

    await markSkillInstalled("test-skill", {
      version: "1.0.0",
      installed_at: new Date().toISOString(),
      method: "batch",
      mirror_used: "direct",
      size_bytes: 1024,
    });

    state = loadInstallState();
    expect(state.installed["test-skill"]).toBeDefined();
    expect(state.partial["test-skill"]).toBeUndefined();
  });

  it("dismissBanner sets banner_dismissed_at", async () => {
    expect(isBannerDismissed()).toBe(false);
    await dismissBanner();
    expect(isBannerDismissed()).toBe(true);
    const state = loadInstallState();
    expect(state.banner_dismissed_at).toBeDefined();
  });

  // -------------------------------------------------------------------
  // Banner cooldown logic (3-day cooldown + 3-dismiss cap)
  // -------------------------------------------------------------------

  it("dismissBanner increments banner_dismiss_count", async () => {
    await dismissBanner();
    let state = loadInstallState();
    expect(state.banner_dismiss_count).toBe(1);

    await dismissBanner();
    state = loadInstallState();
    expect(state.banner_dismiss_count).toBe(2);
  });

  it("isBannerDismissed returns true during 3-day cooldown", async () => {
    await dismissBanner();
    // Immediately after dismiss → in cooldown → dismissed
    expect(isBannerDismissed()).toBe(true);
  });

  it("isBannerDismissed returns false after cooldown expires", async () => {
    // Write state manually with banner_dismissed_at 4 days ago, count=1
    await saveInstallState({
      version: "1.0.0",
      installed: {},
      partial: {},
      banner_dismissed_at: new Date(Date.now() - 4 * 24 * 60 * 60 * 1000).toISOString(),
      banner_dismiss_count: 1,
    });

    // 4 days > 3-day cooldown → not dismissed → banner should reappear
    expect(isBannerDismissed()).toBe(false);
  });

  it("isBannerDismissed returns true permanently after 3 dismissals", async () => {
    // Write state with count=3 and expired cooldown (10 days ago)
    await saveInstallState({
      version: "1.0.0",
      installed: {},
      partial: {},
      banner_dismissed_at: new Date(Date.now() - 10 * 24 * 60 * 60 * 1000).toISOString(),
      banner_dismiss_count: 3,
    });

    // count >= 3 → permanently dismissed, regardless of time
    expect(isBannerDismissed()).toBe(true);
  });

  it("isBannerDismissed cooldown resets on each dismiss", async () => {
    // First dismiss: 4 days ago, count=1 → cooldown expired
    await saveInstallState({
      version: "1.0.0",
      installed: {},
      partial: {},
      banner_dismissed_at: new Date(Date.now() - 4 * 24 * 60 * 60 * 1000).toISOString(),
      banner_dismiss_count: 1,
    });
    expect(isBannerDismissed()).toBe(false);

    // User dismisses again → count=2, new cooldown starts
    await dismissBanner();
    expect(isBannerDismissed()).toBe(true);

    const state = loadInstallState();
    expect(state.banner_dismiss_count).toBe(2);
  });

  it("getInstallStateSummary reflects banner cooldown state", async () => {
    // Not dismissed
    let summary = getInstallStateSummary();
    expect(summary.banner_dismissed).toBe(false);

    // Dismiss once → in cooldown
    await dismissBanner();
    summary = getInstallStateSummary();
    expect(summary.banner_dismissed).toBe(true);

    // Simulate cooldown expired (4 days ago, count=1)
    await saveInstallState({
      version: "1.0.0",
      installed: {},
      partial: {},
      banner_dismissed_at: new Date(Date.now() - 4 * 24 * 60 * 60 * 1000).toISOString(),
      banner_dismiss_count: 1,
    });
    summary = getInstallStateSummary();
    expect(summary.banner_dismissed).toBe(false);

    // Permanently dismissed (count=3)
    await saveInstallState({
      version: "1.0.0",
      installed: {},
      partial: {},
      banner_dismissed_at: new Date(Date.now() - 10 * 24 * 60 * 60 * 1000).toISOString(),
      banner_dismiss_count: 3,
    });
    summary = getInstallStateSummary();
    expect(summary.banner_dismissed).toBe(true);
  });

  it("recordBatchInstallTimestamp sets last_batch_install_at", async () => {
    await recordBatchInstallTimestamp();
    const state = loadInstallState();
    expect(state.last_batch_install_at).toBeDefined();
  });

  it("getInstallStateSummary returns correct counts", async () => {
    await markSkillInstalled("skill-a", {
      version: "1.0.0", installed_at: new Date().toISOString(),
      method: "batch", mirror_used: "direct", size_bytes: 0,
    });
    await markSkillInstalled("skill-b", {
      version: "1.0.0", installed_at: new Date().toISOString(),
      method: "batch", mirror_used: "direct", size_bytes: 0,
    });

    const summary = getInstallStateSummary();
    expect(summary.installed_count).toBe(2);
    expect(summary.partial_count).toBe(0);
    expect(summary.banner_dismissed).toBe(false);
  });

  // -------------------------------------------------------------------
  // Async mutex — concurrent write safety
  // -------------------------------------------------------------------

  it("concurrent markSkillInstalled calls do not overwrite each other", async () => {
    // Simulate concurrency=3: three concurrent installs finishing simultaneously
    const skills = ["alpha", "beta", "gamma", "delta", "epsilon"];

    await Promise.all(
      skills.map((name) =>
        markSkillInstalled(name, {
          version: "1.0.0",
          installed_at: new Date().toISOString(),
          method: "batch",
          mirror_used: `mirror-${name}`,
          size_bytes: 100,
        }),
      ),
    );

    const state = loadInstallState();
    const installedNames = Object.keys(state.installed).sort();
    expect(installedNames).toEqual(skills.sort());

    // Each record should have its own mirror_used
    for (const name of skills) {
      expect(state.installed[name].mirror_used).toBe(`mirror-${name}`);
    }
  });

  it("concurrent mixed operations are serialized correctly", async () => {
    // Mix of markSkillInstalled, markSkillPartial, dismissBanner running concurrently
    await Promise.all([
      markSkillInstalled("s1", {
        version: "1.0.0", installed_at: new Date().toISOString(),
        method: "batch", mirror_used: "m1", size_bytes: 0,
      }),
      markSkillPartial("s2", {
        bytes_downloaded: 500, bytes_total: 1000,
        partial_path: "/tmp/s2.partial", started_at: new Date().toISOString(),
      }),
      dismissBanner(),
      recordBatchInstallTimestamp(),
      markSkillInstalled("s3", {
        version: "1.0.0", installed_at: new Date().toISOString(),
        method: "batch", mirror_used: "m3", size_bytes: 0,
      }),
    ]);

    const state = loadInstallState();
    expect(state.installed["s1"]).toBeDefined();
    expect(state.installed["s3"]).toBeDefined();
    expect(state.partial["s2"]).toBeDefined();
    expect(state.banner_dismissed_at).toBeDefined();
    expect(state.last_batch_install_at).toBeDefined();
  });

  // -------------------------------------------------------------------
  // Windows rename safety — unlink-before-rename
  // -------------------------------------------------------------------

  it("writeStateToDisk handles existing target file (Windows rename)", async () => {
    // First write
    await markSkillInstalled("first", {
      version: "1.0.0", installed_at: new Date().toISOString(),
      method: "batch", mirror_used: "direct", size_bytes: 0,
    });

    // Second write should succeed even though file already exists
    await markSkillInstalled("second", {
      version: "1.0.0", installed_at: new Date().toISOString(),
      method: "batch", mirror_used: "direct", size_bytes: 0,
    });

    const state = loadInstallState();
    expect(state.installed["first"]).toBeDefined();
    expect(state.installed["second"]).toBeDefined();
  });

  // -------------------------------------------------------------------
  // Partial download management
  // -------------------------------------------------------------------

  it("clearPartialDownload removes record and file", async () => {
    const partialPath = path.join(tmpDir, "test-partial.bin");
    await fs.promises.writeFile(partialPath, "partial-content");

    await markSkillPartial("clear-me", {
      bytes_downloaded: 100, bytes_total: 500,
      partial_path: partialPath, started_at: new Date().toISOString(),
    });

    let state = loadInstallState();
    expect(state.partial["clear-me"]).toBeDefined();

    await clearPartialDownload("clear-me");

    state = loadInstallState();
    expect(state.partial["clear-me"]).toBeUndefined();

    // File should be deleted
    const exists = fs.existsSync(partialPath);
    expect(exists).toBe(false);
  });

  it("getPartialDownload returns undefined for stale partials", async () => {
    const partialPath = path.join(tmpDir, "stale.bin");
    await fs.promises.writeFile(partialPath, "x".repeat(100));

    await markSkillPartial("stale-skill", {
      bytes_downloaded: 100, bytes_total: 500,
      partial_path: partialPath,
      // 8 days ago — exceeds PARTIAL_MAX_AGE_MS (7 days)
      started_at: new Date(Date.now() - 8 * 24 * 60 * 60 * 1000).toISOString(),
    });

    const result = getPartialDownload("stale-skill");
    expect(result).toBeUndefined();
  });

  it("getPartialDownload returns undefined when file size doesn't match", async () => {
    const partialPath = path.join(tmpDir, "mismatch.bin");
    await fs.promises.writeFile(partialPath, "abc"); // 3 bytes

    await markSkillPartial("mismatch-skill", {
      bytes_downloaded: 100, // says 100, but file is only 3 bytes
      bytes_total: 500,
      partial_path: partialPath,
      started_at: new Date().toISOString(),
    });

    const result = getPartialDownload("mismatch-skill");
    expect(result).toBeUndefined();
  });

  it("getPartialDownload returns record when valid", async () => {
    const partialPath = path.join(tmpDir, "valid.bin");
    const content = "valid-partial-content";
    await fs.promises.writeFile(partialPath, content);

    await markSkillPartial("valid-skill", {
      bytes_downloaded: Buffer.byteLength(content),
      bytes_total: 500,
      partial_path: partialPath,
      started_at: new Date().toISOString(),
    });

    const result = getPartialDownload("valid-skill");
    expect(result).toBeDefined();
    expect(result!.bytes_downloaded).toBe(Buffer.byteLength(content));
  });

  // -------------------------------------------------------------------
  // Prune stale partials
  // -------------------------------------------------------------------

  it("pruneStalePartials removes old entries", async () => {
    const freshPath = path.join(tmpDir, "fresh.bin");
    const stalePath = path.join(tmpDir, "stale.bin");
    await fs.promises.writeFile(freshPath, "fresh");
    await fs.promises.writeFile(stalePath, "stale");

    await markSkillPartial("fresh", {
      bytes_downloaded: 5, bytes_total: 100,
      partial_path: freshPath, started_at: new Date().toISOString(),
    });
    await markSkillPartial("stale", {
      bytes_downloaded: 5, bytes_total: 100,
      partial_path: stalePath,
      started_at: new Date(Date.now() - 8 * 24 * 60 * 60 * 1000).toISOString(),
    });

    const pruned = await pruneStalePartials();
    expect(pruned).toBe(1);

    const state = loadInstallState();
    expect(state.partial["fresh"]).toBeDefined();
    expect(state.partial["stale"]).toBeUndefined();
  });

  // -------------------------------------------------------------------
  // Corrupt / invalid state file recovery
  // -------------------------------------------------------------------

  it("returns empty state for corrupted JSON", async () => {
    const statePath = path.join(tmpDir, "skills-install-state.json");
    await fs.promises.writeFile(statePath, "NOT-VALID-JSON{{{");

    const state = loadInstallState();
    expect(state.version).toBe("1.0.0");
    expect(Object.keys(state.installed)).toHaveLength(0);
  });

  it("returns empty state for structurally invalid object", async () => {
    const statePath = path.join(tmpDir, "skills-install-state.json");
    await fs.promises.writeFile(statePath, JSON.stringify({ foo: "bar" }));

    const state = loadInstallState();
    expect(state.version).toBe("1.0.0");
    expect(Object.keys(state.installed)).toHaveLength(0);
  });
});
