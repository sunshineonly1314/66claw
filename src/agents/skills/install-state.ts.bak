/**
 * Skills Install State Manager
 * Manages persistent state for batch skill installations.
 * OpenClawCN: batch install state persistence
 *
 * Uses an async mutex to serialize read-modify-write operations,
 * preventing data loss when multiple concurrent installs complete.
 */

import fs from "node:fs";
import path from "node:path";
import { CONFIG_DIR, ensureDir } from "../../utils.js";

export type InstalledSkillRecord = {
  version: string;
  installed_at: string;
  method: string;
  mirror_used: string;
  size_bytes: number;
};

export type PartialDownloadRecord = {
  bytes_downloaded: number;
  bytes_total: number;
  partial_path: string;
  started_at: string;
};

export type SkillsInstallState = {
  version: string;
  installed: Record<string, InstalledSkillRecord>;
  partial: Record<string, PartialDownloadRecord>;
  banner_dismissed_at?: string;
  banner_dismiss_count?: number;
  last_batch_install_at?: string;
};

const STATE_FILE_NAME = "skills-install-state.json";
const CURRENT_VERSION = "1.0.0";
const PARTIAL_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;

// ---------------------------------------------------------------------------
// Async mutex — serializes read-modify-write operations on the state file.
// Without this, concurrent markSkillInstalled() calls from batchInstall
// (concurrency=3) can overwrite each other's records.
// ---------------------------------------------------------------------------

let _mutexQueue: Promise<void> = Promise.resolve();

function withStateLock<T>(fn: () => Promise<T>): Promise<T> {
  const prev = _mutexQueue;
  let resolve: () => void;
  _mutexQueue = new Promise<void>((r) => {
    resolve = r;
  });
  return prev.then(async () => {
    try {
      return await fn();
    } finally {
      resolve!();
    }
  });
}

// ---------------------------------------------------------------------------
// Disk I/O
// ---------------------------------------------------------------------------

function getStatePath(): string {
  return path.join(CONFIG_DIR, STATE_FILE_NAME);
}

function createEmptyState(): SkillsInstallState {
  return { version: CURRENT_VERSION, installed: {}, partial: {} };
}

function readStateFromDisk(): SkillsInstallState {
  const filePath = getStatePath();
  try {
    const raw = fs.readFileSync(filePath, "utf-8");
    const parsed = JSON.parse(raw) as SkillsInstallState;
    if (
      typeof parsed !== "object" ||
      parsed === null ||
      typeof parsed.version !== "string" ||
      typeof parsed.installed !== "object" ||
      typeof parsed.partial !== "object"
    ) {
      return createEmptyState();
    }
    return parsed;
  } catch {
    return createEmptyState();
  }
}

async function writeStateToDisk(state: SkillsInstallState): Promise<void> {
  const filePath = getStatePath();
  await ensureDir(path.dirname(filePath));
  const tmpPath = filePath + ".tmp";
  await fs.promises.writeFile(tmpPath, JSON.stringify(state, null, 2), "utf-8");
  // On Windows, rename fails if target exists. Remove target first.
  try {
    await fs.promises.unlink(filePath);
  } catch {
    /* may not exist */
  }
  await fs.promises.rename(tmpPath, filePath);
}

// ---------------------------------------------------------------------------
// Public API — all write operations are serialized via withStateLock
// ---------------------------------------------------------------------------

export function loadInstallState(): SkillsInstallState {
  return readStateFromDisk();
}

export async function saveInstallState(state: SkillsInstallState): Promise<void> {
  await withStateLock(() => writeStateToDisk(state));
}

export async function markSkillInstalled(
  skillName: string,
  record: InstalledSkillRecord,
): Promise<void> {
  await withStateLock(async () => {
    const state = readStateFromDisk();
    state.installed[skillName] = record;
    delete state.partial[skillName];
    await writeStateToDisk(state);
  });
}

export async function markSkillPartial(
  skillName: string,
  record: PartialDownloadRecord,
): Promise<void> {
  await withStateLock(async () => {
    const state = readStateFromDisk();
    state.partial[skillName] = record;
    await writeStateToDisk(state);
  });
}

export async function clearPartialDownload(skillName: string): Promise<void> {
  await withStateLock(async () => {
    const state = readStateFromDisk();
    const partial = state.partial[skillName];
    if (partial) {
      try {
        await fs.promises.unlink(partial.partial_path);
      } catch {
        /* ignore */
      }
      delete state.partial[skillName];
      await writeStateToDisk(state);
    }
  });
}

export function getPartialDownload(skillName: string): PartialDownloadRecord | undefined {
  const state = readStateFromDisk();
  const partial = state.partial[skillName];
  if (!partial) return undefined;
  const age = Date.now() - new Date(partial.started_at).getTime();
  if (age > PARTIAL_MAX_AGE_MS) return undefined;
  try {
    const stat = fs.statSync(partial.partial_path);
    if (stat.size !== partial.bytes_downloaded) return undefined;
  } catch {
    return undefined;
  }
  return partial;
}

export async function dismissBanner(): Promise<void> {
  await withStateLock(async () => {
    const state = readStateFromDisk();
    state.banner_dismissed_at = new Date().toISOString();
    state.banner_dismiss_count = (state.banner_dismiss_count ?? 0) + 1;
    await writeStateToDisk(state);
  });
}

/**
 * Banner 关闭策略:
 * - 每次点击"稍后"后,有 3 天冷却期不再显示
 * - 累计点击 3 次后,永久关闭横幅
 * - 冷却期过后,横幅会重新显示 (除非已点击 3 次)
 */
const BANNER_COOLDOWN_MS = 3 * 24 * 60 * 60 * 1000; // 3 天冷却期
const BANNER_MAX_DISMISS_COUNT = 3; // 点击"稍后"三次后永久关闭

export function isBannerDismissed(): boolean {
  const state = readStateFromDisk();
  if (!state.banner_dismissed_at) return false;
  if ((state.banner_dismiss_count ?? 0) >= BANNER_MAX_DISMISS_COUNT) return true;
  const dismissedAt = new Date(state.banner_dismissed_at).getTime();
  return Date.now() - dismissedAt < BANNER_COOLDOWN_MS;
}

export async function recordBatchInstallTimestamp(): Promise<void> {
  await withStateLock(async () => {
    const state = readStateFromDisk();
    state.last_batch_install_at = new Date().toISOString();
    await writeStateToDisk(state);
  });
}

export async function pruneStalePartials(): Promise<number> {
  return withStateLock(async () => {
    const state = readStateFromDisk();
    const now = Date.now();
    let pruned = 0;
    for (const [skillName, partial] of Object.entries(state.partial)) {
      if (now - new Date(partial.started_at).getTime() > PARTIAL_MAX_AGE_MS) {
        try {
          await fs.promises.unlink(partial.partial_path);
        } catch {
          /* ignore */
        }
        delete state.partial[skillName];
        pruned++;
      }
    }
    if (pruned > 0) await writeStateToDisk(state);
    return pruned;
  });
}

export function getInstallStateSummary(): {
  installed_count: number;
  partial_count: number;
  banner_dismissed: boolean;
  last_batch_install_at: string | null;
} {
  const state = readStateFromDisk();
  return {
    installed_count: Object.keys(state.installed).length,
    partial_count: Object.keys(state.partial).length,
    banner_dismissed: isBannerDismissed(),
    last_batch_install_at: state.last_batch_install_at ?? null,
  };
}
