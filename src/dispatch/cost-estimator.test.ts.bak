import { describe, expect, it, beforeEach } from "vitest";
import {
  estimateTokens,
  estimateOutputTokens,
  estimateCost,
  getModelPricing,
  checkBudget,
  recordSpending,
  getSpending,
  suggestModel,
  clearSpendingLog,
} from "./cost-estimator.js";

beforeEach(() => {
  clearSpendingLog();
});

// ---------------------------------------------------------------------------
// estimateTokens
// ---------------------------------------------------------------------------

describe("estimateTokens", () => {
  it("returns 0 for empty string", () => {
    expect(estimateTokens("")).toBe(0);
  });

  it("estimates English text at ~4 chars/token", () => {
    const text = "This is a simple test sentence for token estimation.";
    const tokens = estimateTokens(text);
    // 52 chars / 4 = 13 tokens
    expect(tokens).toBeGreaterThanOrEqual(10);
    expect(tokens).toBeLessThanOrEqual(20);
  });

  it("estimates CJK text at ~1.5 chars/token", () => {
    const text = "这是一个简单的中文测试句子";
    const tokens = estimateTokens(text);
    // 12 CJK chars / 1.5 = 8 tokens
    expect(tokens).toBeGreaterThanOrEqual(6);
    expect(tokens).toBeLessThanOrEqual(12);
  });

  it("handles mixed CJK + English text", () => {
    const text = "这是TypeScript的测试 with mixed content";
    const tokens = estimateTokens(text);
    // Should be between pure-CJK and pure-English estimates
    expect(tokens).toBeGreaterThan(0);
    expect(tokens).toBeLessThan(50);
  });
});

// ---------------------------------------------------------------------------
// estimateOutputTokens
// ---------------------------------------------------------------------------

describe("estimateOutputTokens", () => {
  it("low complexity → ~200 tokens", () => {
    expect(estimateOutputTokens("low", "single")).toBe(200);
  });

  it("high complexity → ~2000 tokens", () => {
    expect(estimateOutputTokens("high", "single")).toBe(2000);
  });

  it("multi strategy multiplies by 3", () => {
    expect(estimateOutputTokens("high", "multi")).toBe(6000);
  });

  it("enhanced strategy multiplies by 1.5", () => {
    expect(estimateOutputTokens("medium", "enhanced")).toBe(1200);
  });
});

// ---------------------------------------------------------------------------
// getModelPricing
// ---------------------------------------------------------------------------

describe("getModelPricing", () => {
  it("returns exact match pricing", () => {
    const pricing = getModelPricing("claude-haiku-3");
    expect(pricing.inputPer1M).toBe(0.25);
    expect(pricing.outputPer1M).toBe(1.25);
  });

  it("returns partial match pricing (model with version suffix)", () => {
    const pricing = getModelPricing("claude-sonnet-4-5-20250929");
    expect(pricing.inputPer1M).toBe(3.0);
  });

  it("returns default pricing for unknown model", () => {
    const pricing = getModelPricing("some-unknown-model-xyz");
    expect(pricing.inputPer1M).toBe(3.0); // default fallback
    expect(pricing.outputPer1M).toBe(15.0);
  });
});

// ---------------------------------------------------------------------------
// estimateCost
// ---------------------------------------------------------------------------

describe("estimateCost", () => {
  it("calculates cost for a simple request", () => {
    const est = estimateCost({
      prompt: "Hello world",
      model: "claude-haiku-3",
      complexity: "low",
      strategy: "single",
    });
    expect(est.costUsd).toBeGreaterThan(0);
    expect(est.costUsd).toBeLessThan(0.01); // haiku + low = very cheap
    expect(est.inputTokens).toBeGreaterThan(0);
    expect(est.outputTokens).toBe(200);
    expect(est.model).toBe("claude-haiku-3");
  });

  it("expensive model + high complexity costs significantly more", () => {
    const cheap = estimateCost({
      prompt: "Hi",
      model: "claude-haiku-3",
      complexity: "low",
      strategy: "single",
    });
    const expensive = estimateCost({
      prompt: "Please do a comprehensive analysis of the entire market...",
      model: "claude-opus-4-6",
      complexity: "high",
      strategy: "multi",
    });
    expect(expensive.costUsd).toBeGreaterThan(cheap.costUsd * 10);
  });

  it("applies prompt caching discount", () => {
    const noCaching = estimateCost({
      prompt: "Test prompt for caching comparison",
      model: "claude-sonnet-4-5",
      complexity: "medium",
      strategy: "single",
    });
    const withCaching = estimateCost({
      prompt: "Test prompt for caching comparison",
      model: "claude-sonnet-4-5",
      complexity: "medium",
      strategy: "single",
      cachedInput: true,
    });
    expect(withCaching.costUsd).toBeLessThan(noCaching.costUsd);
    expect(withCaching.cachedInput).toBe(true);
  });
});

// ---------------------------------------------------------------------------
// Budget Guard
// ---------------------------------------------------------------------------

describe("checkBudget", () => {
  it("allows request within budget", () => {
    const est = estimateCost({
      prompt: "Hi",
      model: "claude-haiku-3",
      complexity: "low",
      strategy: "single",
    });
    const result = checkBudget(est, {
      maxPerRequestUsd: 1.0,
      maxHourlyUsd: 10.0,
      maxDailyUsd: 50.0,
    });
    expect(result.allowed).toBe(true);
  });

  it("blocks request exceeding per-request limit", () => {
    const est = estimateCost({
      prompt: "Big request",
      model: "claude-opus-4-6",
      complexity: "high",
      strategy: "multi",
    });
    const result = checkBudget(est, {
      maxPerRequestUsd: 0.0001, // very low limit
      maxHourlyUsd: 100.0,
      maxDailyUsd: 500.0,
    });
    expect(result.allowed).toBe(false);
    expect(result.reason).toContain("per-request limit");
    expect(result.suggestedModel).toBeDefined();
  });

  it("blocks when hourly spend exceeded", () => {
    // Simulate prior spending that nearly exhausts the hourly budget
    recordSpending(9.99);
    const est = estimateCost({
      prompt: "Another request",
      model: "claude-sonnet-4-5",
      complexity: "medium",
      strategy: "single",
    });
    const result = checkBudget(est, {
      maxPerRequestUsd: 1.0,
      maxHourlyUsd: 10.0,
      maxDailyUsd: 50.0,
    });
    expect(result.allowed).toBe(false);
    expect(result.reason).toContain("Hourly spend");
  });
});

// ---------------------------------------------------------------------------
// recordSpending + getSpending
// ---------------------------------------------------------------------------

describe("spending tracking", () => {
  it("tracks spending in time windows", () => {
    recordSpending(0.5);
    recordSpending(0.3);
    const total = getSpending(60 * 60 * 1000); // last hour
    expect(total).toBeCloseTo(0.8);
  });
});

// ---------------------------------------------------------------------------
// suggestModel
// ---------------------------------------------------------------------------

describe("suggestModel", () => {
  it("suggests a model within budget", () => {
    const model = suggestModel({
      complexity: "low",
      strategy: "single",
      inputTokens: 100,
      maxCostUsd: 0.01,
    });
    expect(model).toBeDefined();
    // Should suggest a cheap model for low complexity
    expect([
      "claude-haiku-3",
      "gpt-4o-mini",
      "qwen-turbo",
      "deepseek-chat",
      "glm-4-flash",
    ]).toContain(model);
  });

  it("returns null when no model fits budget", () => {
    const model = suggestModel({
      complexity: "high",
      strategy: "multi",
      inputTokens: 100000,
      maxCostUsd: 0.000001, // impossibly low budget
    });
    expect(model).toBeNull();
  });
});
