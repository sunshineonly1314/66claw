/**
 * Dispatch Engine — main entry point for intelligent routing.
 *
 * Takes a user prompt + config → returns a RoutingDecision that specifies
 * the optimal model, skills, and MCP tools for the request.
 */

import { DEFAULT_PROVIDER } from "../agents/defaults.js";
import { createSubsystemLogger } from "../logging/subsystem.js";
import { parseModelRef } from "../agents/model-selection.js";

const log = createSubsystemLogger("dispatch/engine");
import {
  assessComplexityByRules,
  resolveStrategy,
  scoreToComplexityLevel,
} from "./complexity-classifier.js";
import { loadDispatchConfig } from "./config-loader.js";
import {
  checkBudget,
  estimateCost,
  recordSpending,
} from "./cost-estimator.js";
import {
  buildEventFromDecision,
  isTelemetryEnabled,
  recordEvent,
  setTelemetryEnabled,
} from "./dispatch-telemetry.js";
import { classifyIntent } from "./intent-classifier.js";
import { checkResources, recordOutcome } from "./resource-guard.js";
import { adjustComplexity, analyzeSessionContext, recordTurn } from "./session-context.js";
import type {
  ComplexityLevel,
  CompiledDispatchConfig,
  CompiledIntent,
  DispatchRequestParams,
  RoutingDecision,
} from "./types.js";

// ---------------------------------------------------------------------------
// Default (pass-through) routing decision
// ---------------------------------------------------------------------------

const DEFAULT_DECISION: RoutingDecision = {
  intent: "default",
  confidence: 0,
  classifierUsed: "default",
  modelOverride: null,
  skillHints: [],
  mcpToolHints: [],
  complexity: "medium",
  strategy: "single",
};

// ---------------------------------------------------------------------------
// Media-type confidence boost
// ---------------------------------------------------------------------------

/** Boost added to an intent when its declared mediaTypes overlap with the request. */
const MEDIA_BOOST = 0.25;

/**
 * Boost confidence for intents whose declared `patterns.mediaTypes` overlap
 * with the actual media types attached to the request.
 */
function applyMediaBoost(
  intentDef: CompiledIntent,
  mediaTypes: string[] | undefined,
  currentConfidence: number,
): number {
  if (!mediaTypes || mediaTypes.length === 0) return currentConfidence;
  const declaredMedia = intentDef.patterns.mediaTypes;
  if (!declaredMedia || declaredMedia.length === 0) return currentConfidence;

  const mediaLower = new Set(mediaTypes.map((m) => m.toLowerCase()));
  const hasOverlap = declaredMedia.some((d) => mediaLower.has(d.toLowerCase()));
  if (hasOverlap) {
    return Math.min(1.0, currentConfidence + MEDIA_BOOST);
  }
  return currentConfidence;
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

/**
 * Run the dispatch engine: classify the prompt and produce a routing decision.
 *
 * This is the single entry point called before followupRun construction.
 * It is designed to be fast (< 50ms for rule-based matches) and safe
 * (never throws, always returns a valid RoutingDecision).
 */
export async function dispatchRequest(params: DispatchRequestParams): Promise<RoutingDecision> {
  const startTime = performance.now();
  let ruleLatencyMs = 0;
  let llmLatencyMs = 0;

  try {
    // 1. Load dispatch config (cached with hot-reload)
    const dispatchConfig = loadDispatchConfig({
      agentDir: params.agentDir,
      workspaceDir: params.workspaceDir,
    });

    // 2. If no config found or dispatch is disabled, pass through
    if (!dispatchConfig || !dispatchConfig.settings.enabled) {
      return DEFAULT_DECISION;
    }

    // Enable telemetry if debug mode is on
    if (dispatchConfig.settings.debug && !isTelemetryEnabled()) {
      setTelemetryEnabled(true);
    }

    // 3. Classify intent (track latency)
    const classifyStart = performance.now();
    const classification = await classifyIntent({
      prompt: params.prompt,
      config: dispatchConfig,
      openclawcnConfig: params.openclawcnConfig,
      agentDir: params.agentDir,
      signal: params.signal,
    });
    const classifyDuration = performance.now() - classifyStart;

    if (classification.classifierUsed === "llm") {
      llmLatencyMs = classifyDuration;
    } else {
      ruleLatencyMs = classifyDuration;
    }

    // 4. Look up the matched intent definition
    const intentDef = dispatchConfig.intents.find((i) => i.id === classification.intentId);
    if (!intentDef) {
      log.warn(
        `Classified intent "${classification.intentId}" not found in config — using default routing`,
      );
      return DEFAULT_DECISION;
    }

    // Early abort check — skip remaining pipeline if request was cancelled
    if (params.signal?.aborted) return DEFAULT_DECISION;

    // 5. Apply media-type boost to confidence
    const boostedConfidence = applyMediaBoost(
      intentDef,
      params.mediaTypes,
      classification.confidence,
    );

    // 6. Re-evaluate: if media boost pushed a previously lower intent above threshold,
    //    check if a different intent benefits more from media context.
    const finalIntent = maybeReclassifyWithMedia(
      dispatchConfig,
      intentDef,
      boostedConfidence,
      classification,
      params.mediaTypes,
    );

    // 7. Resolve model override (with fallback support)
    const modelOverride = resolveModelWithFallback(finalIntent.intentDef);

    // 8. Resolve MCP tool hints (expand wildcards)
    const mcpToolHints = expandMCPToolPatterns(
      finalIntent.intentDef.mcpTools,
      params.availableMCPTools ?? [],
    );

    // 9. Assess complexity
    let { complexity, strategy, complexitySignals } = assessComplexity(
      params.prompt,
      finalIntent.intentDef.id,
      classification.llmComplexity,
      dispatchConfig,
    );

    // 10. Session context analysis — adjust complexity based on conversation history
    let sessionSignals: RoutingDecision["sessionSignals"];
    if (params.sessionId) {
      const sessionCtx = analyzeSessionContext(
        params.sessionId,
        params.prompt,
        finalIntent.intentDef.id,
      );

      if (sessionCtx.complexityAdjustment !== 0) {
        complexity = adjustComplexity(complexity, sessionCtx.complexityAdjustment);
        // Re-derive strategy with adjusted complexity
        strategy = resolveStrategy(complexity, finalIntent.intentDef.id);
      }

      sessionSignals = {
        turnCount: sessionCtx.turnCount,
        topicContinuation: sessionCtx.topicContinuation,
        complexityTrend: sessionCtx.complexityTrend,
        complexityAdjustment: sessionCtx.complexityAdjustment,
      };
    }

    // 10.5 Memory signal adjustment — boost complexity when memory indicates
    //      cross-session continuation of a complex prior task.
    //      This prevents "继续昨天的调研" (5 chars, looks trivial) from being
    //      routed as low complexity when the prior task was high complexity.
    if (params.memorySignals) {
      const ms = params.memorySignals;
      const hasStrongMemory = ms.relevanceScore != null && ms.relevanceScore >= 0.7;

      // Cross-session continuation with high prior complexity → boost
      if (ms.crossSessionContinuation && ms.priorComplexity === "high") {
        complexity = adjustComplexity(complexity, +1);
        complexitySignals = [...(complexitySignals ?? []), "memory_cross_session_high"];
        strategy = resolveStrategy(complexity, finalIntent.intentDef.id);
      }
      // High relevance recall + same intent → inherit prior complexity (never downgrade)
      else if (
        hasStrongMemory &&
        ms.priorIntent === finalIntent.intentDef.id &&
        ms.priorComplexity
      ) {
        const levels: Record<string, number> = { low: 0, medium: 1, high: 2 };
        if ((levels[ms.priorComplexity] ?? 0) > (levels[complexity] ?? 0)) {
          complexity = ms.priorComplexity;
          complexitySignals = [...(complexitySignals ?? []), "memory_relevance_boost"];
          strategy = resolveStrategy(complexity, finalIntent.intentDef.id);
        }
      }
    }

    // 11. Resource guard — check if strategy is allowed under current pressure.
    //     We use checkResources() (read-only) instead of applyResourceGuard()
    //     because the dispatch engine only decides routing — it doesn't hold the
    //     actual LLM request slot. Slot acquisition should happen at the LLM call site.
    const resourceCheck = checkResources(strategy);
    const finalStrategy = resourceCheck.allowed
      ? strategy
      : (resourceCheck.degradedStrategy ?? "single");
    const strategyDegraded = !resourceCheck.allowed;

    if (strategyDegraded && dispatchConfig.settings.debug) {
      log.debug(
        `Strategy degraded: ${strategy} → ${finalStrategy} (${resourceCheck.reason})`,
      );
    }

    // 12. Apply strategy-based model override (if configured and no intent-level override)
    const strategyModelOverride = resolveStrategyModelOverride(
      finalStrategy,
      dispatchConfig,
      modelOverride,
    );

    // 13. Cost estimation + budget guard
    let effectiveModelOverride = strategyModelOverride ?? modelOverride;
    let modelName = effectiveModelOverride ? effectiveModelOverride.model : "claude-sonnet-4-5";
    let costEstimate = estimateCost({
      prompt: params.prompt,
      model: modelName,
      complexity,
      strategy: finalStrategy,
    });

    // 13.5 Budget guard — downgrade model if estimated cost exceeds limits
    if (dispatchConfig.budget) {
      const budgetCheck = checkBudget(costEstimate, dispatchConfig.budget);
      if (!budgetCheck.allowed && budgetCheck.suggestedModel) {
        if (dispatchConfig.settings.debug) {
          log.debug(
            `Budget guard: ${budgetCheck.reason} → downgrading to ${budgetCheck.suggestedModel}`,
          );
        }
        const downgraded = resolveModelOverride(budgetCheck.suggestedModel);
        if (downgraded) {
          effectiveModelOverride = downgraded;
          modelName = downgraded.model;
          // Re-estimate with cheaper model
          costEstimate = estimateCost({
            prompt: params.prompt,
            model: modelName,
            complexity,
            strategy: finalStrategy,
          });
        }
      }
    }

    // Record estimated spending for hourly/daily budget tracking
    recordSpending(costEstimate.costUsd);

    // 14. Build routing decision
    const decision: RoutingDecision = {
      intent: finalIntent.intentDef.id,
      confidence: finalIntent.confidence,
      classifierUsed: classification.classifierUsed,
      modelOverride: effectiveModelOverride,
      skillHints: finalIntent.intentDef.skills,
      mcpToolHints,
      systemHint: finalIntent.intentDef.systemHint,
      complexity,
      strategy: finalStrategy,
      complexitySignals,
      estimatedCostUsd: costEstimate.costUsd,
      strategyDegraded,
      sessionSignals,
      toolBinding: finalIntent.intentDef.toolBinding,
    };

    // 15. Record telemetry event
    const durationMs = performance.now() - startTime;
    const telemetryEventId = recordEvent(
      buildEventFromDecision({
        decision,
        prompt: params.prompt,
        durationMs,
        ruleLatencyMs,
        llmLatencyMs,
        estimatedInputTokens: costEstimate.inputTokens,
        estimatedCostUsd: costEstimate.costUsd,
      }),
    );
    decision.telemetryEventId = telemetryEventId;

    // 16. Record turn in session context
    if (params.sessionId) {
      recordTurn(params.sessionId, {
        timestamp: Date.now(),
        promptSnippet: params.prompt,
        intent: decision.intent,
        complexity: decision.complexity,
        strategy: decision.strategy,
        promptLength: params.prompt.length,
      });
    }

    if (dispatchConfig.settings.debug) {
      const modelStr = decision.modelOverride
        ? `${decision.modelOverride.provider}/${decision.modelOverride.model}`
        : "default";
      const mediaStr = params.mediaTypes?.length ? ` media=[${params.mediaTypes.join(",")}]` : "";
      const costStr = ` est_cost=$${costEstimate.costUsd.toFixed(6)}`;
      const sessionStr = sessionSignals
        ? ` session={turns=${sessionSignals.turnCount},trend=${sessionSignals.complexityTrend}}`
        : "";
      log.debug(
        `Decision: intent=${decision.intent} confidence=${decision.confidence.toFixed(2)} ` +
          `classifier=${decision.classifierUsed} model=${modelStr} ` +
          `complexity=${decision.complexity} strategy=${decision.strategy} ` +
          `signals=[${(decision.complexitySignals ?? []).join(",")}] ` +
          `skills=[${decision.skillHints.join(",")}] mcp=[${decision.mcpToolHints.join(",")}]` +
          `${costStr}${sessionStr}${mediaStr} (${durationMs.toFixed(1)}ms)`,
      );
    }

    // Record successful outcome for circuit breaker health tracking.
    // Without this, the breaker can only accumulate failures and will
    // permanently trip after a burst of transient errors.
    recordOutcome(true);

    return decision;
  } catch (err) {
    log.warn("Engine error, using default routing:", { error: err });
    recordOutcome(false);
    return DEFAULT_DECISION;
  }
}

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Complexity assessment
// ---------------------------------------------------------------------------

/**
 * Assess task complexity using a two-layer approach:
 * 1. Rule-based heuristics (instant, < 5ms)
 * 2. LLM classification result (piggy-backed onto intent classification, zero extra cost)
 *
 * When the LLM provided a complexity level, it takes priority over rules —
 * unless the rules are very confident (clear simple greeting or clear complex request).
 */
function assessComplexity(
  prompt: string,
  intentId: string,
  llmComplexity: ComplexityLevel | undefined,
  config: CompiledDispatchConfig,
): { complexity: ComplexityLevel; strategy: ExecutionStrategy; complexitySignals: string[] } {
  // If complexity assessment is disabled, default to medium/single
  if (!config.complexity?.enabled) {
    return { complexity: "medium", strategy: "single", complexitySignals: [] };
  }

  // Step 1: Rule-based assessment
  const ruleResult = assessComplexityByRules(prompt);

  // Step 2: Determine final complexity
  let complexity: ComplexityLevel;

  if (ruleResult.confident) {
    // Rules are decisive — use rule result directly
    complexity = scoreToComplexityLevel(ruleResult.score);
  } else if (llmComplexity) {
    // Rules uncertain, LLM provided a level — use LLM
    complexity = llmComplexity;
  } else {
    // Both uncertain — fall back to rules
    complexity = scoreToComplexityLevel(ruleResult.score);
  }

  // Step 3: Derive execution strategy
  const strategy = resolveStrategy(complexity, intentId);

  return {
    complexity,
    strategy,
    complexitySignals: ruleResult.signals,
  };
}

// Reuse the type from complexity-classifier (import already added)
type ExecutionStrategy = import("./types.js").ExecutionStrategy;

/**
 * When a strategy-specific model is configured in dispatch.yaml, use it
 * to override the model — but only if no intent-level model override exists.
 */
function resolveStrategyModelOverride(
  strategy: ExecutionStrategy,
  config: CompiledDispatchConfig,
  intentModelOverride: { provider: string; model: string } | null,
): { provider: string; model: string } | null {
  // Intent-level model takes precedence
  if (intentModelOverride) return null;

  const strategies = config.complexity?.strategies;
  if (!strategies) return null;

  let modelSpec: string | undefined;

  if (strategy === "single" && strategies.single?.model) {
    modelSpec = strategies.single.model;
  } else if (strategy === "enhanced" && strategies.enhanced?.model) {
    modelSpec = strategies.enhanced.model;
  } else if (strategy === "multi" && strategies.multi?.orchestratorModel) {
    modelSpec = strategies.multi.orchestratorModel;
  }

  if (!modelSpec) return null;
  return resolveModelOverride(modelSpec);
}

// ---------------------------------------------------------------------------
// Media reclassification
// ---------------------------------------------------------------------------

/**
 * If media context strongly signals a different intent than the text classifier chose,
 * switch to that intent. This handles cases like: user sends an image with "这是什么"
 * (what is this) — text matches general, but image should boost image-related intents.
 */
function maybeReclassifyWithMedia(
  config: CompiledDispatchConfig,
  textIntent: CompiledIntent,
  textConfidence: number,
  classification: { classifierUsed: "rules" | "llm" | "default" },
  mediaTypes: string[] | undefined,
): { intentDef: CompiledIntent; confidence: number } {
  if (!mediaTypes || mediaTypes.length === 0) {
    return { intentDef: textIntent, confidence: textConfidence };
  }

  // Find intents that declare matching media types
  let bestMediaIntent: CompiledIntent | null = null;
  let bestMediaScore = 0;
  const mediaLower = new Set(mediaTypes.map((m) => m.toLowerCase()));

  for (const intent of config.intents) {
    if (intent.id === textIntent.id) continue;
    const declaredMedia = intent.patterns.mediaTypes;
    if (!declaredMedia || declaredMedia.length === 0) continue;

    const overlapCount = declaredMedia.filter((d) => mediaLower.has(d.toLowerCase())).length;
    if (overlapCount === 0) continue;

    // Media-only score for this intent
    const mediaScore = MEDIA_BOOST * (overlapCount / declaredMedia.length);
    if (mediaScore > bestMediaScore) {
      bestMediaScore = mediaScore;
      bestMediaIntent = intent;
    }
  }

  // Only switch intent if the media signal is strong AND the text classifier
  // had low confidence on the original intent
  if (bestMediaIntent && bestMediaScore > 0.15 && textConfidence < 0.5) {
    if (config.settings.debug) {
      log.debug(
        `Media reclassify: ${textIntent.id} → ${bestMediaIntent.id} ` +
          `(media=${mediaTypes.join(",")}, textConf=${textConfidence.toFixed(2)})`,
      );
    }
    return {
      intentDef: bestMediaIntent,
      confidence: Math.min(1.0, bestMediaScore + textConfidence * 0.3),
    };
  }

  return { intentDef: textIntent, confidence: textConfidence };
}

/**
 * Resolve the model override for an intent, trying fallbackModel if primary fails.
 */
function resolveModelWithFallback(
  intentDef: CompiledIntent,
): { provider: string; model: string } | null {
  // Try primary model
  if (intentDef.routing.model) {
    const primary = resolveModelOverride(intentDef.routing.model);
    if (primary) return primary;

    // Primary model ref invalid — try fallback
    if (intentDef.routing.fallbackModel) {
      log.warn(
        `Primary model "${intentDef.routing.model}" for intent "${intentDef.id}" ` +
          `failed to resolve, trying fallback "${intentDef.routing.fallbackModel}"`,
      );
      const fallback = resolveModelOverride(intentDef.routing.fallbackModel);
      if (fallback) return fallback;
      log.warn(
        `Fallback model "${intentDef.routing.fallbackModel}" also failed for intent "${intentDef.id}"`,
      );
    }
  }
  return null;
}

/**
 * Resolve a model spec string into a { provider, model } pair.
 * Reuses the existing parseModelRef from model-selection.ts.
 */
function resolveModelOverride(modelSpec: string): { provider: string; model: string } | null {
  const ref = parseModelRef(modelSpec, DEFAULT_PROVIDER);
  if (!ref) return null;
  return { provider: ref.provider, model: ref.model };
}

/**
 * Expand MCP tool name patterns (with wildcard support).
 * Example: "mcp_database_*" matches "mcp_database_query", "mcp_database_list_tables", etc.
 */
function expandMCPToolPatterns(patterns: string[], availableTools: string[]): string[] {
  if (patterns.length === 0) return [];

  const result = new Set<string>();

  for (const pattern of patterns) {
    if (pattern.includes("*")) {
      // Convert glob pattern to regex
      const regexStr =
        "^" + pattern.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*") + "$";
      const regex = new RegExp(regexStr);
      for (const tool of availableTools) {
        if (regex.test(tool)) {
          result.add(tool);
        }
      }
    } else {
      // Exact match — only add if tool actually exists
      if (availableTools.includes(pattern)) {
        result.add(pattern);
      }
    }
  }

  return Array.from(result);
}
