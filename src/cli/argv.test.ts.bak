import { describe, expect, it } from "vitest";
import {
  buildParseArgv,
  getFlagValue,
  getCommandPath,
  getPrimaryCommand,
  getPositiveIntFlagValue,
  getVerboseFlag,
  hasHelpOrVersion,
  hasFlag,
  shouldMigrateState,
  shouldMigrateStateFromPath,
} from "./argv.js";

describe("argv helpers", () => {
  it("detects help/version flags", () => {
    expect(hasHelpOrVersion(["node", "openclawcn", "--help"])).toBe(true);
    expect(hasHelpOrVersion(["node", "openclawcn", "-V"])).toBe(true);
    expect(hasHelpOrVersion(["node", "openclawcn", "status"])).toBe(false);
  });

  it("extracts command path ignoring flags and terminator", () => {
    expect(getCommandPath(["node", "openclawcn", "status", "--json"], 2)).toEqual(["status"]);
    expect(getCommandPath(["node", "openclawcn", "agents", "list"], 2)).toEqual(["agents", "list"]);
    expect(getCommandPath(["node", "openclawcn", "status", "--", "ignored"], 2)).toEqual(["status"]);
  });

  it("returns primary command", () => {
    expect(getPrimaryCommand(["node", "openclawcn", "agents", "list"])).toBe("agents");
    expect(getPrimaryCommand(["node", "openclawcn"])).toBeNull();
  });

  it("parses boolean flags and ignores terminator", () => {
    expect(hasFlag(["node", "openclawcn", "status", "--json"], "--json")).toBe(true);
    expect(hasFlag(["node", "openclawcn", "--", "--json"], "--json")).toBe(false);
  });

  it("extracts flag values with equals and missing values", () => {
    expect(getFlagValue(["node", "openclawcn", "status", "--timeout", "5000"], "--timeout")).toBe(
      "5000",
    );
    expect(getFlagValue(["node", "openclawcn", "status", "--timeout=2500"], "--timeout")).toBe(
      "2500",
    );
    expect(getFlagValue(["node", "openclawcn", "status", "--timeout"], "--timeout")).toBeNull();
    expect(getFlagValue(["node", "openclawcn", "status", "--timeout", "--json"], "--timeout")).toBe(
      null,
    );
    expect(getFlagValue(["node", "openclawcn", "--", "--timeout=99"], "--timeout")).toBeUndefined();
  });

  it("parses verbose flags", () => {
    expect(getVerboseFlag(["node", "openclawcn", "status", "--verbose"])).toBe(true);
    expect(getVerboseFlag(["node", "openclawcn", "status", "--debug"])).toBe(false);
    expect(getVerboseFlag(["node", "openclawcn", "status", "--debug"], { includeDebug: true })).toBe(
      true,
    );
  });

  it("parses positive integer flag values", () => {
    expect(getPositiveIntFlagValue(["node", "openclawcn", "status"], "--timeout")).toBeUndefined();
    expect(
      getPositiveIntFlagValue(["node", "openclawcn", "status", "--timeout"], "--timeout"),
    ).toBeNull();
    expect(
      getPositiveIntFlagValue(["node", "openclawcn", "status", "--timeout", "5000"], "--timeout"),
    ).toBe(5000);
    expect(
      getPositiveIntFlagValue(["node", "openclawcn", "status", "--timeout", "nope"], "--timeout"),
    ).toBeUndefined();
  });

  it("builds parse argv from raw args", () => {
    const nodeArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node", "openclawcn", "status"],
    });
    expect(nodeArgv).toEqual(["node", "openclawcn", "status"]);

    const versionedNodeArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node-22", "openclawcn", "status"],
    });
    expect(versionedNodeArgv).toEqual(["node-22", "openclawcn", "status"]);

    const versionedNodeWindowsArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node-22.2.0.exe", "openclawcn", "status"],
    });
    expect(versionedNodeWindowsArgv).toEqual(["node-22.2.0.exe", "openclawcn", "status"]);

    const versionedNodePatchlessArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node-22.2", "openclawcn", "status"],
    });
    expect(versionedNodePatchlessArgv).toEqual(["node-22.2", "openclawcn", "status"]);

    const versionedNodeWindowsPatchlessArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node-22.2.exe", "openclawcn", "status"],
    });
    expect(versionedNodeWindowsPatchlessArgv).toEqual(["node-22.2.exe", "openclawcn", "status"]);

    const versionedNodeWithPathArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["/usr/bin/node-22.2.0", "openclawcn", "status"],
    });
    expect(versionedNodeWithPathArgv).toEqual(["/usr/bin/node-22.2.0", "openclawcn", "status"]);

    const nodejsArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["nodejs", "openclawcn", "status"],
    });
    expect(nodejsArgv).toEqual(["nodejs", "openclawcn", "status"]);

    const nonVersionedNodeArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["node-dev", "openclawcn", "status"],
    });
    expect(nonVersionedNodeArgv).toEqual(["node", "openclawcn", "node-dev", "openclawcn", "status"]);

    const directArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["openclawcn", "status"],
    });
    expect(directArgv).toEqual(["node", "openclawcn", "status"]);

    const bunArgv = buildParseArgv({
      programName: "openclawcn",
      rawArgs: ["bun", "src/entry.ts", "status"],
    });
    expect(bunArgv).toEqual(["bun", "src/entry.ts", "status"]);
  });

  it("builds parse argv from fallback args", () => {
    const fallbackArgv = buildParseArgv({
      programName: "openclawcn",
      fallbackArgv: ["status"],
    });
    expect(fallbackArgv).toEqual(["node", "openclawcn", "status"]);
  });

  it("decides when to migrate state", () => {
    expect(shouldMigrateState(["node", "openclawcn", "status"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "health"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "sessions"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "config", "get", "update"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "config", "unset", "update"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "models", "list"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "models", "status"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "memory", "status"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "agent", "--message", "hi"])).toBe(false);
    expect(shouldMigrateState(["node", "openclawcn", "agents", "list"])).toBe(true);
    expect(shouldMigrateState(["node", "openclawcn", "message", "send"])).toBe(true);
  });

  it("reuses command path for migrate state decisions", () => {
    expect(shouldMigrateStateFromPath(["status"])).toBe(false);
    expect(shouldMigrateStateFromPath(["config", "get"])).toBe(false);
    expect(shouldMigrateStateFromPath(["models", "status"])).toBe(false);
    expect(shouldMigrateStateFromPath(["agents", "list"])).toBe(true);
  });
});
