import path from "node:path";
import { describe, expect, it } from "vitest";
import { formatCliCommand } from "./command-format.js";
import { applyCliProfileEnv, parseCliProfileArgs } from "./profile.js";

describe("parseCliProfileArgs", () => {
  it("leaves gateway --dev for subcommands", () => {
    const res = parseCliProfileArgs([
      "node",
      "openclawcn",
      "gateway",
      "--dev",
      "--allow-unconfigured",
    ]);
    if (!res.ok) {
      throw new Error(res.error);
    }
    expect(res.profile).toBeNull();
    expect(res.argv).toEqual(["node", "openclawcn", "gateway", "--dev", "--allow-unconfigured"]);
  });

  it("still accepts global --dev before subcommand", () => {
    const res = parseCliProfileArgs(["node", "openclawcn", "--dev", "gateway"]);
    if (!res.ok) {
      throw new Error(res.error);
    }
    expect(res.profile).toBe("dev");
    expect(res.argv).toEqual(["node", "openclawcn", "gateway"]);
  });

  it("parses --profile value and strips it", () => {
    const res = parseCliProfileArgs(["node", "openclawcn", "--profile", "work", "status"]);
    if (!res.ok) {
      throw new Error(res.error);
    }
    expect(res.profile).toBe("work");
    expect(res.argv).toEqual(["node", "openclawcn", "status"]);
  });

  it("rejects missing profile value", () => {
    const res = parseCliProfileArgs(["node", "openclawcn", "--profile"]);
    expect(res.ok).toBe(false);
  });

  it("rejects combining --dev with --profile (dev first)", () => {
    const res = parseCliProfileArgs(["node", "openclawcn", "--dev", "--profile", "work", "status"]);
    expect(res.ok).toBe(false);
  });

  it("rejects combining --dev with --profile (profile first)", () => {
    const res = parseCliProfileArgs(["node", "openclawcn", "--profile", "work", "--dev", "status"]);
    expect(res.ok).toBe(false);
  });
});

describe("applyCliProfileEnv", () => {
  it("fills env defaults for dev profile", () => {
    const env: Record<string, string | undefined> = {};
    applyCliProfileEnv({
      profile: "dev",
      env,
      homedir: () => "/home/peter",
    });
    const expectedStateDir = path.join(path.resolve("/home/peter"), ".openclawcn-dev");
    expect(env.OPENCLAWCN_PROFILE).toBe("dev");
    expect(env.OPENCLAWCN_STATE_DIR).toBe(expectedStateDir);
    expect(env.OPENCLAWCN_CONFIG_PATH).toBe(path.join(expectedStateDir, "openclawcn.json"));
    expect(env.OPENCLAWCN_GATEWAY_PORT).toBe("19001");
  });

  it("does not override explicit env values", () => {
    const env: Record<string, string | undefined> = {
      OPENCLAWCN_STATE_DIR: "/custom",
      OPENCLAWCN_GATEWAY_PORT: "19099",
    };
    applyCliProfileEnv({
      profile: "dev",
      env,
      homedir: () => "/home/peter",
    });
    expect(env.OPENCLAWCN_STATE_DIR).toBe("/custom");
    expect(env.OPENCLAWCN_GATEWAY_PORT).toBe("19099");
    expect(env.OPENCLAWCN_CONFIG_PATH).toBe(path.join("/custom", "openclawcn.json"));
  });

  it("uses OPENCLAWCN_HOME when deriving profile state dir", () => {
    const env: Record<string, string | undefined> = {
      OPENCLAWCN_HOME: "/srv/openclawcn-home",
      HOME: "/home/other",
    };
    applyCliProfileEnv({
      profile: "work",
      env,
      homedir: () => "/home/fallback",
    });

    const resolvedHome = path.resolve("/srv/openclawcn-home");
    expect(env.OPENCLAWCN_STATE_DIR).toBe(path.join(resolvedHome, ".openclawcn-work"));
    expect(env.OPENCLAWCN_CONFIG_PATH).toBe(
      path.join(resolvedHome, ".openclawcn-work", "openclawcn.json"),
    );
  });
});

describe("formatCliCommand", () => {
  it("returns command unchanged when no profile is set", () => {
    expect(formatCliCommand("openclawcn doctor --fix", {})).toBe("openclawcn doctor --fix");
  });

  it("returns command unchanged when profile is default", () => {
    expect(formatCliCommand("openclawcn doctor --fix", { OPENCLAWCN_PROFILE: "default" })).toBe(
      "openclawcn doctor --fix",
    );
  });

  it("returns command unchanged when profile is Default (case-insensitive)", () => {
    expect(formatCliCommand("openclawcn doctor --fix", { OPENCLAWCN_PROFILE: "Default" })).toBe(
      "openclawcn doctor --fix",
    );
  });

  it("returns command unchanged when profile is invalid", () => {
    expect(formatCliCommand("openclawcn doctor --fix", { OPENCLAWCN_PROFILE: "bad profile" })).toBe(
      "openclawcn doctor --fix",
    );
  });

  it("returns command unchanged when --profile is already present", () => {
    expect(
      formatCliCommand("openclawcn --profile work doctor --fix", { OPENCLAWCN_PROFILE: "work" }),
    ).toBe("openclawcn --profile work doctor --fix");
  });

  it("returns command unchanged when --dev is already present", () => {
    expect(formatCliCommand("openclawcn --dev doctor", { OPENCLAWCN_PROFILE: "dev" })).toBe(
      "openclawcn --dev doctor",
    );
  });

  it("inserts --profile flag when profile is set", () => {
    expect(formatCliCommand("openclawcn doctor --fix", { OPENCLAWCN_PROFILE: "work" })).toBe(
      "openclawcn --profile work doctor --fix",
    );
  });

  it("trims whitespace from profile", () => {
    expect(formatCliCommand("openclawcn doctor --fix", { OPENCLAWCN_PROFILE: "  jbopenclaw  " })).toBe(
      "openclawcn --profile jbopenclaw doctor --fix",
    );
  });

  it("handles command with no args after openclawcn", () => {
    expect(formatCliCommand("openclawcn", { OPENCLAWCN_PROFILE: "test" })).toBe(
      "openclawcn --profile test",
    );
  });

  it("handles pnpm wrapper", () => {
    expect(formatCliCommand("pnpm openclawcn doctor", { OPENCLAWCN_PROFILE: "work" })).toBe(
      "pnpm openclawcn --profile work doctor",
    );
  });
});
