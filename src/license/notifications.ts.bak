/**
 * OpenClawCN License Module - Notification Management
 * 通知处理逻辑
 */

import fs from "node:fs";
import path from "node:path";

import { resolveStateDir } from "../config/paths.js";
import { createSubsystemLogger } from "../logging/subsystem.js";
import type { LicenseNotification, ShownNotificationRecord } from "./types.js";

const log = createSubsystemLogger("license:notifications");

const SHOWN_NOTIFICATIONS_FILENAME = "shown_notifications.json";

/**
 * 获取已展示通知记录文件路径
 */
function getShownNotificationsFilePath(): string {
  const stateDir = resolveStateDir();
  return path.join(stateDir, SHOWN_NOTIFICATIONS_FILENAME);
}

/**
 * 加载已展示的通知记录
 */
export function loadShownNotifications(): ShownNotificationRecord[] {
  const filePath = getShownNotificationsFilePath();

  try {
    if (!fs.existsSync(filePath)) {
      return [];
    }

    const content = fs.readFileSync(filePath, "utf8");
    const records = JSON.parse(content) as ShownNotificationRecord[];

    return Array.isArray(records) ? records : [];
  } catch (error) {
    log.warn(`Failed to load shown notifications: ${error}`);
    return [];
  }
}

/**
 * 保存已展示的通知记录
 */
function saveShownNotifications(records: ShownNotificationRecord[]): void {
  const filePath = getShownNotificationsFilePath();

  try {
    const dir = path.dirname(filePath);
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
    }

    fs.writeFileSync(filePath, JSON.stringify(records, null, 2), "utf8");
  } catch (error) {
    log.warn(`Failed to save shown notifications: ${error}`);
  }
}

/**
 * 标记通知为已展示
 */
export function markNotificationAsShown(notificationId: number): void {
  const records = loadShownNotifications();

  // 检查是否已存在
  if (records.some((r) => r.id === notificationId)) {
    return;
  }

  records.push({
    id: notificationId,
    shownAt: Date.now(),
  });

  saveShownNotifications(records);
  log.debug(`Notification marked as shown: ${notificationId}`);
}

/**
 * 检查通知是否已展示
 */
export function hasNotificationBeenShown(notificationId: number): boolean {
  const records = loadShownNotifications();
  return records.some((r) => r.id === notificationId);
}

/**
 * 获取已展示的通知 ID 列表
 */
export function getShownNotificationIds(): number[] {
  const records = loadShownNotifications();
  return records.map((r) => r.id);
}

/**
 * 清理过期的通知记录（保留最近 30 天的）
 */
export function cleanupOldNotificationRecords(retentionDays: number = 30): void {
  const records = loadShownNotifications();
  const cutoffTime = Date.now() - retentionDays * 24 * 60 * 60 * 1000;

  const filteredRecords = records.filter((r) => r.shownAt >= cutoffTime);

  if (filteredRecords.length < records.length) {
    saveShownNotifications(filteredRecords);
    log.debug(
      `Cleaned up ${records.length - filteredRecords.length} old notification records`,
    );
  }
}

/**
 * 过滤需要展示的通知
 *
 * 过滤规则：
 * 1. showOnce 的通知如果已展示过则跳过
 * 2. 已过期（validUntil）的通知跳过
 * 3. 按优先级排序
 */
export function filterNotificationsToShow(
  notifications: LicenseNotification[] | null,
): LicenseNotification[] {
  if (!notifications || notifications.length === 0) {
    return [];
  }

  const now = Date.now();
  const shownIds = new Set(getShownNotificationIds());

  const filtered = notifications.filter((notif) => {
    // 检查是否已展示（对于 showOnce 类型）
    if (notif.showOnce && shownIds.has(notif.id)) {
      return false;
    }

    // 检查有效期
    if (notif.validUntil) {
      const validUntil = new Date(notif.validUntil).getTime();
      if (now > validUntil) {
        return false;
      }
    }

    return true;
  });

  // 按优先级降序排序
  filtered.sort((a, b) => b.priority - a.priority);

  return filtered;
}

/**
 * 处理通知展示
 *
 * @param notifications - 通知列表
 * @param onShow - 展示回调函数
 */
export async function processNotifications(
  notifications: LicenseNotification[] | null,
  onShow: (notification: LicenseNotification) => Promise<"clicked" | "dismissed" | "closed">,
): Promise<void> {
  const toShow = filterNotificationsToShow(notifications);

  if (toShow.length === 0) {
    return;
  }

  log.debug(`Processing ${toShow.length} notifications`);

  for (const notif of toShow) {
    try {
      const action = await onShow(notif);

      // 标记为已展示
      markNotificationAsShown(notif.id);

      log.debug(`Notification ${notif.id} processed with action: ${action}`);
    } catch (error) {
      log.warn(`Failed to process notification ${notif.id}: ${error}`);
    }
  }
}

/**
 * 获取通知的显示样式配置
 */
export function getNotificationDisplayConfig(notification: LicenseNotification): {
  type: "dialog" | "banner" | "toast";
  urgent: boolean;
  hasAction: boolean;
} {
  const isUrgent =
    notification.type === "force_update" ||
    notification.type === "maintenance" ||
    notification.priority >= 8;

  return {
    type: notification.displayStyle,
    urgent: isUrgent,
    hasAction: !!notification.action,
  };
}
