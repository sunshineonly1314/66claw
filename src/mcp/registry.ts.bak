/**
 * MCP Server Registry — manages server configurations.
 *
 * Reads from openclawcn.yaml `mcp.servers[]` config section.
 */

import type { MCPServerConfig, MCPConfig } from "./types.js";
import { MCP_MAX_SERVERS } from "./types.js";

export class MCPRegistry {
  private servers = new Map<string, MCPServerConfig>();

  /** Load server configs from the mcp config section. */
  loadFromConfig(mcpConfig: MCPConfig | undefined): MCPServerConfig[] {
    this.servers.clear();
    const entries = mcpConfig?.servers ?? [];
    for (const entry of entries) {
      // SSE servers don't need a command, stdio servers do
      if (!entry.id) continue;
      if (entry.transport !== "sse" && !entry.command) continue;
      const config: MCPServerConfig = {
        id: entry.id,
        command: entry.command ?? "",
        args: entry.args,
        env: entry.env,
        cwd: entry.cwd,
        transport: entry.transport ?? "stdio",
        url: entry.url,
        headers: entry.headers,
        version: entry.version,
        enabled: entry.enabled !== false,
        autoStart: entry.autoStart !== false,
        timeout: entry.timeout,
      };
      this.servers.set(config.id, config);
    }
    return this.getAllServers();
  }

  /** Get a single server config. */
  getServer(id: string): MCPServerConfig | undefined {
    return this.servers.get(id);
  }

  /** Get all registered server configs. */
  getAllServers(): MCPServerConfig[] {
    return [...this.servers.values()];
  }

  /** Add or update a server config. */
  addServer(config: MCPServerConfig): void {
    if (!this.servers.has(config.id) && this.servers.size >= MCP_MAX_SERVERS) {
      throw new Error(`Cannot add MCP server: maximum of ${MCP_MAX_SERVERS} servers reached`);
    }
    this.servers.set(config.id, config);
  }

  /** Remove a server config. */
  removeServer(id: string): boolean {
    return this.servers.delete(id);
  }

  /** Check if a server is registered. */
  hasServer(id: string): boolean {
    return this.servers.has(id);
  }
}
